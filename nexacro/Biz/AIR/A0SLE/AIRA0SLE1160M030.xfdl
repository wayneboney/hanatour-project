              <Static id="stc01" taborder="2" text="승객정보입력" left="0" width="1000" cssclass="sta_WF_SubTitle02" fittocontents="width" height="35" top="div00:0"/>
              <Div id="div01" taborder="4" text="div01" left="0" cssclass="div_WF_Detail_m" right="0" top="stc01:0" formscrollbartype="none" height="57">
                <Layouts>
                  <Layout>
                    <Grid id="grdBdngInfo" taborder="2" left="0" autofittype="col" right="0" top="0" height="56" binddataset="ds_BdngInfo" autoenter="select" oncellclick="divPaxInfo_div01_grdBdngInfo_oncellclick" onkeyup="divPaxInfo_div01_grdBdngInfo_onkeyup" oncellposchanged="divPaxInfo_div01_grdBdngInfo_oncellposchanged" scrollbartype="none none" onexpandup="divPaxInfo_div01_grdBdngInfo_onexpandup">
                      <Formats>
                        <Format id="default">
                          <Columns>
                            <Column size="48"/>
                            <Column size="48"/>
                            <Column size="80"/>
                            <Column size="80"/>
                            <Column size="120"/>
                            <Column size="60"/>
                            <Column size="120"/>
                            <Column size="120"/>
                            <Column size="120"/>
                            <Column size="120"/>
                          </Columns>
                          <Rows>
                            <Row size="34" band="head"/>
                            <Row size="24" band="head"/>
                            <Row size="24"/>
                            <Row size="24"/>
                          </Rows>
                          <Band id="head">
                            <Cell rowspan="2" text="순번"/>
                            <Cell col="1" rowspan="2" text="구분"/>
                            <Cell col="2" rowspan="2" text="한글성명"/>
                            <Cell col="3" rowspan="2" text="영문성"/>
                            <Cell col="4" rowspan="2" text="영문이름"/>
                            <Cell col="5" rowspan="2" text="성별"/>
                            <Cell col="6" text="법정생년월일"/>
                            <Cell col="7" text="휴대폰&lt;fc v='#f44336'&gt;&#13;&#10;(모든 탑승객 필수)&lt;/fc&gt;" displaytype="decoratetext"/>
                            <Cell col="8" colspan="2" text="E-mail&#13;&#10;&lt;fc v='#f44336'&gt;(모든 탑승객 필수)&lt;/fc&gt;" displaytype="decoratetext"/>
                            <Cell row="1" col="6" text="여권번호"/>
                            <Cell row="1" col="7" text="여권만료일"/>
                            <Cell row="1" col="8" text="발행국"/>
                            <Cell row="1" col="9" text="국적"/>
                          </Band>
                          <Band id="body">
                            <Cell rowspan="2" displaytype="text" expr="currow+1" background="#ffffff"/>
                            <Cell col="1" rowspan="2" displaytype="text" text="expr:dataset.parent.gfn_isNull(pasnType) ? ageTypeNm : (pasnTypeNm.length &gt; 2 ? pasnTypeNm.substring(0,2)+&quot;...&quot; : pasnTypeNm)" tooltiptext="expr:dataset.parent.gfn_isNull(pasnType) ? &quot;&quot;:  (pasnTypeNm.length &gt; 2 ? pasnTypeNm : &quot;&quot;)  " background="#ffffff"/>
                            <Cell col="2" rowspan="2" displaytype="editcontrol" edittype="text" editimemode="none" text="bind:paxLclName" editautoselect="false" editinputfilter="alpha,comma,digit,dot,sign,space,symbol" background="#ffffff" padding="13px 4px"/>
                            <Cell col="3" rowspan="2" displaytype="editcontrol" edittype="text" editimemode="alpha" editinputmode="upper" text="bind:paxLastName" editinputtype="sign,space,alpha" background="#ffffff" padding="13px 4px"/>
                            <Cell col="4" rowspan="2" displaytype="editcontrol" edittype="text" editimemode="alpha" editinputmode="upper" text="bind:paxFirstName" editinputtype="sign,space,alpha" background="#ffffff" padding="13px 4px"/>
                            <Cell col="5" rowspan="2" displaytype="combocontrol" edittype="combo" combodataset="ds_gndr" combocodecol="genderVal" combodatacol="genderNm" text="bind:gender" background="#ffffff"/>
                            <Cell col="6" displaytype="editcontrol" edittype="text" editinputtype="digit" editmaxlength="8" text="bind:birthDay" background="#ffffff" color="#435059" expr="(birthDay==undefined || birthDay=='')?&quot;ex)19880626&quot;:birthDay"/>
                            <Cell col="7" displaytype="editcontrol" edittype="text" editinputtype="digit" text="bind:mobileNo" background="#ffffff" expr="(mobileNo==undefined || mobileNo=='')?&quot;ex)01012341234&quot;:mobileNo"/>
                            <Cell col="8" colspan="2" displaytype="editcontrol" edittype="text" text="bind:email" background="#ffffff" expr="(email==undefined || email=='')?&quot;ex)manager@hanatour.com&quot;:email"/>
                            <Cell row="1" col="6" cssclass="expr:romaStatus == 1 ? &quot;RedFocus&quot;:&quot;&quot;" text="bind:tustPpn" displaytype="editcontrol" edittype="normal" editimemode="alpha" editinputmode="upper" editinputtype="alpha,sign,number,digit"/>
                            <Cell row="1" col="7" cssclass="expr:tustPsptExpyDtYn == 'N' ? &quot;Red&quot;:&quot;&quot;" text="bind:tustPsptExpyDt" displaytype="calendarcontrol" edittype="date" calendardateformat="yyyy-MM-dd" calendardisplaynulltype="nullmask"/>
                            <Cell row="1" col="8" displaytype="editcontrol" edittype="normal" expandshow="show" text="bind:tustPsptPublCntryCd"/>
                            <Cell row="1" col="9" displaytype="editcontrol" edittype="normal" text="bind:tustCntryCd" expandshow="show"/>
                          </Band>
                        </Format>
                      </Formats>
                    </Grid>
                  </Layout>
                </Layouts>
              </Div>
              <Div id="div03" taborder="7" left="0" height="5" top="div01:0" text="" right="0">
                <Layouts>
                  <Layout>
                    <Static id="stcStayInfo" taborder="0" text="체류지정보" left="0" width="1000" cssclass="sta_WF_SubTitle02" fittocontents="width" height="0" visible="false" top="5"/>
                    <Button id="btn_copy" taborder="3" text="1번째 승객과 동일" top="10" cssclass="btn_WF_Custom" fittocontents="width" onclick="tab_reqMng_Tabpage_stayInfo_btn_copy_onclick" enable="true" height="26" defaultbutton="false" right="13" width="126" visible="false"/>
                    <Grid id="grdStay" taborder="1" left="0" binddataset="ds_stayList" autofittype="col" readonly="false" enable="true" top="stcStayInfo:0" visible="false" oncellclick="divPaxInfo_div03_grdStay_oncellclick" height="0" right="0">
                      <Formats>
                        <Format id="default">
                          <Columns>
                            <Column size="50"/>
                            <Column size="200"/>
                            <Column size="90"/>
                            <Column size="25"/>
                            <Column size="100"/>
                            <Column size="100"/>
                            <Column size="130"/>
                            <Column size="25"/>
                            <Column size="100"/>
                            <Column size="250"/>
                            <Column size="120"/>
                          </Columns>
                          <Rows>
                            <Row size="32" band="head"/>
                            <Row size="24"/>
                          </Rows>
                          <Band id="head">
                            <Cell text="순번"/>
                            <Cell col="1" text="탑승객명"/>
                            <Cell col="2" colspan="2" text="거주국가" cssclass="Essen"/>
                            <Cell col="4" text="체류국가"/>
                            <Cell col="5" text="체류주(STATE)" cssclass="Essen"/>
                            <Cell col="6" colspan="2" text="체류도시(CITY)" cssclass="Essen"/>
                            <Cell col="8" text="체류도시명"/>
                            <Cell col="9" text="주소(STREET)" cssclass="Essen"/>
                            <Cell col="10" text="우편번호&#13;&#10;(ZIP CODE)" cssclass="Essen"/>
                          </Band>
                          <Band id="body">
                            <Cell expr="currow+1" displaytype="text" background="#ffffff"/>
                            <Cell col="1" text="bind:paxLclName" background="#ffffff"/>
                            <Cell col="2" displaytype="editcontrol" edittype="text" expandshow="hide" expandsize="16" border="0px none,0px none,1px solid #c4cdd0" text="bind:curRsplCntryCd" editimemode="alpha" editinputfilter="none" editinputmode="upper" editinputtype="alpha,number" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" background="#ffffff"/>
                            <Cell col="3" expandshow="show" expandsize="23" verticalAlign="middle" border="0px none,1px solid #c4cdd0,1px solid #c4cdd0,0px none" padding="0px 0px 0px 0px" textAlign="left" cssclass="psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" edittype="none" displaytype="normal" background="#ffffff"/>
                            <Cell col="4" text="bind:stayCntryCd" displaytype="normal" edittype="none" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" background="#ffffff"/>
                            <Cell col="5" text="bind:stayStateEnNm" displaytype="normal" edittype="none" tooltiptype="default" verticalAlign="middle" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" background="#ffffff"/>
                            <Cell col="6" text="bind:stayCityCd" displaytype="editcontrol" edittype="text" expandshow="hide" expandsize="16" border="0px none,0px none,1px solid #c4cdd0" editimemode="alpha" editinputfilter="none" editinputmode="upper" editinputtype="alpha,number" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" background="#ffffff"/>
                            <Cell col="7" expandshow="show" expandsize="23" textAlign="left" padding="0px" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" background="#ffffff"/>
                            <Cell col="8" text="bind:stayCityEnNm" displaytype="normal" edittype="none" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" background="#ffffff"/>
                            <Cell col="9" displaytype="editcontrol" edittype="text" text="bind:tmpresEnAdrs" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" editinputtype="alpha,number,space" editinputfilter="comma,symbol,dot,sign" editmaxlength="35" background="#ffffff"/>
                            <Cell col="10" displaytype="editcontrol" edittype="text" text="bind:tmpresZip" cssclass="expr:psngrCnclStatCd==&quot;NN&quot;? &quot;&quot; :&quot;AI_Disable&quot;" editinputfilter="comma,symbol,dot,sign" editinputtype="number" background="#ffffff"/>
                          </Band>
                        </Format>
                      </Formats>
                    </Grid>
                  </Layout>
                </Layouts>
              </Div>
              <Div id="div02" taborder="3" text="div02" left="0" cssclass="div_WF_Detail_m" right="0" top="div03:0" height="53" formscrollbartype="none none">
