this.fn_romanizaion_check_process = function(rowIndex ,bodyNm ,bodyOldNm) {
	if (this.ds_roma.rowcount < 1) this.ds_roma.addRow();
 	tustKoNm = this.ds_BdngInfo.getColumn(rowIndex, "paxLclName");
    tustEnln = this.ds_BdngInfo.getColumn(rowIndex, "paxLastName");
    tustEnNm = this.ds_BdngInfo.getColumn(rowIndex, "paxFirstName");
	tustPpn ="";
	tustBthd="";
			
	// 모든 데이터 컬럼은 null이 아니여야하고, 이전 값과는 달라야한다
	if (this.romanization_diff_check(rowIndex, tustKoNm, tustEnln, tustEnNm, tustPpn, tustBthd,bodyOldNm)){
		this.lastIndex = rowIndex;
		this.ds_roma.setColumn(0, "tustKoNm", tustKoNm);
		this.ds_roma.setColumn(0, "tustEnln", tustEnln);
		this.ds_roma.setColumn(0, "tustEnNm", tustEnNm);
		this.ds_roma.setColumn(0, "psptNo", "");
		this.ds_roma.setColumn(0, "birthDay", "");
		
		if(this.fareTypeNdc==="N" || this.fareTypeNdc==="R"){//NDC이고 여권번호이면 추가
			if(bodyOldNm ==="paxLclName" || bodyOldNm ==="tustPpn" || bodyOldNm ==="birthDay"){
				this.ds_roma.setColumn(0, "psptNo", this.ds_BdngInfo.getColumn(rowIndex, "tustPpn"));
				if (tustPpn == null || 0 < tustPpn.indexOf("1111")) this.ds_roma.setColumn(0, "psptNo","");	
				this.ds_roma.setColumn(0, "birthDay", this.ds_BdngInfo.getColumn(rowIndex, "birthDay"));
			}
		}
		
		// 공통Transaction 호출
		var sSvcId  		= "detectEnNmTypo";
		var sSvcUrl  		= "svcUrl::";
		var sInDs   		= "body=ds_roma:U"; //:U 는 갱신된 정보만을 보냄 :A 는 모든 정보 :N 은 현재 삭제한 데이터를 제외한 정보를 Normal 상태로 보냅니다. 지정하지 않은 DataSet 은 Normal 로 동작합니다.
		var sOutDs  		= "ds_rsvTustEnNmDictOut=body"; 
		var sArg 			= "";
		var sCallbackFunc 	= "fn_romanizaion_check_callBack";
		
		// 초기값은 fn_tranInit 설정
		var objHeader = this.bfn_rsvTranInit();  //this.fn_tranInit();

		objHeader.svcTrncId = "/air/ols/reserve/rsvTust/rsvTustEnNmDict/detectEnNmTypo/v1.00";		// 헤더_서비스 처리_서비스거래ID
		this.gfn_callTran(this, sSvcId, sSvcUrl, sInDs, sOutDs, sArg, sCallbackFunc, objHeader);	
	}
};

this.romanization_diff_check = function(rowIndex,tustKoNm, tustEnln, tustEnNm, tustPpn, tustBthd, bodyOldNm) {	
	//이전과 동일하지 않다면 체크
	if(this.fareTypeNdc==="N" || this.fareTypeNdc==="R" && (bodyOldNm ==="paxLclName" || bodyOldNm ==="birthDay"|| bodyOldNm ==="tustPpn")){//NDC 여권번호 체크 로직
 		tustPpn = this.ds_BdngInfo.getColumn(rowIndex, "tustPpn");	
 		if (tustPpn == null || 0 < tustPpn.indexOf("1111")) tustPpn = "";
 		tustBthd = this.ds_BdngInfo.getColumn(rowIndex, "birthDay");
				
		if ((!this.gfn_isNull(tustKoNm) && !this.gfn_isNull(tustEnln) && !this.gfn_isNull(tustEnNm) && !this.gfn_isNull(tustPpn) && !this.gfn_isNull(tustBthd) )
		  && (this.ds_roma.getColumn(0, "tustKoNm") != tustKoNm || this.ds_roma.getColumn(0, "tustEnln") != tustEnln || this.ds_roma.getColumn(0, "tustEnNm") != tustEnNm
			|| this.ds_roma.getColumn(0, "psptNo") != tustPpn || this.ds_roma.getColumn(0, "birthDay") != tustBthd
		  )){    
			return true;
		}
	}else{
		if ((!this.gfn_isNull(tustKoNm) && !this.gfn_isNull(tustEnln) && !this.gfn_isNull(tustEnNm))
		  && (this.ds_roma.getColumn(0, "tustKoNm") != tustKoNm || this.ds_roma.getColumn(0, "tustEnln") != tustEnln || this.ds_roma.getColumn(0, "tustEnNm") != tustEnNm)){    
			return true;
		}
	}
	return false;
};

this.fn_romanizaion_check_callBack = function(sSvcId, nErrorCode, sErrorMsg) {
	if (nErrorCode == 0 && 201 < this.ds_rsvTustEnNmDictOut.getColumn(0, "statusCode")) {
		message = this.ds_rsvTustEnNmDictOut.getColumn(0, "message");
		if (this.ds_rsvTustEnNmDictOut.getColumn(0, "statusCode") - 410 > 0) {
         message = this.ds_rsvTustEnNmDictOut.getColumn(0, "statusCode") == 411 ?
               "여권 정보와 일치하지 않습니다. 입력 정보가 <b v='true'>여권과 일치하는지</b> 다시 확인해 주세요."
               : "영문 성 또는 영문 이름이 <b v='true'>실제 여권 정보와 일치하지 않습니다.</b> 다시 확인해 주세요.";
         this.ds_BdngInfo.setColumn(this.bdngIndex, "romaStatus", this.ds_rsvTustEnNmDictOut.getColumn(0, "statusCode") - 410);		
		}
		
		this.fn_roma_log_create_or_update(this.ds_rsvTustEnNmDictOut.getColumn(0, "statusCode"));
		this.divPaxInfo.form.stc02.set_text("※" + message);
		this.divPaxInfo.form.stc02.set_visible(true);
		this.setTimer(90890, 7000);
	}
};

this.lastIndex = 0;
this.fn_roma_log_create_or_update = function(status) {
	const ERROR_STATUS = 400;
	if (ERROR_STATUS <= status) {
		var rowIndex = -1;
		for (var i=0 ; i < this.ds_roma_logging.rowcount ; i++) {
			if (this.ds_roma_logging.getColumn(i, "index") == this.lastIndex) {
				rowIndex = i;
			}
		}
		if (rowIndex == -1) {
			this.ds_roma_logging.addRow();
			rowIndex = this.ds_roma_logging.rowcount-1;
		}
		this.ds_roma_logging.setColumn(rowIndex, "beforeResult", status);
		this.ds_roma_logging.setColumn(rowIndex, "index", this.lastIndex);
		this.ds_roma_logging.setColumn(rowIndex, "beforeTustKoNm", this.ds_roma.getColumn(0, "tustKoNm"));
		this.ds_roma_logging.setColumn(rowIndex, "beforeTustEnln", this.ds_roma.getColumn(0, "tustEnln"));
		this.ds_roma_logging.setColumn(rowIndex, "beforeTustEnNm", this.ds_roma.getColumn(0, "tustEnNm"));
	}
};

this.fn_roam_log_update_after = function ()
{
	for (var i=0 ; i < this.ds_roma_logging.rowcount ; i++) {
		var index = this.ds_roma_logging.getColumn(i, "index");
		this.ds_roma_logging.setColumn(i, "afterTustKoNm", this.ds_BdngInfo.getColumn(index, "paxLclName"));
		this.ds_roma_logging.setColumn(i, "afterTustEnln", this.ds_BdngInfo.getColumn(index, "paxLastName"));
		this.ds_roma_logging.setColumn(i, "afterTustEnNm", this.ds_BdngInfo.getColumn(index, "paxFirstName"));
	}
};

this.fn_romanizaion_result_logging = function() {
	if (this.ds_roma_logging_body.rowcount == 0) {
		this.ds_roma_logging_body.addRow();
		this.ds_roma_logging_body.setColumn(0, "siteCode", "PPT_PC");
	}
	// 공통Transaction 호출
	var sSvcId  		= "detectEnNmTypoLogging";
	var sSvcUrl  		= "svcUrl::";
	var sInDs   		= "body=ds_roma_logging_body body_resultInVoList=ds_roma_logging:U"; //:U 는 갱신된 정보만을 보냄 :A 는 모든 정보 :N 은 현재 삭제한 데이터를 제외한 정보를 Normal 상태로 보냅니다. 지정하지 않은 DataSet 은 Normal 로 동작합니다.
	var sOutDs  		= ""; 
	var sArg 			= "";
	var sCallbackFunc 	= "fn_callBack";
	
	// 초기값은 fn_tranInit 설정
	var objHeader = this.bfn_rsvTranInit();  //this.fn_tranInit();

	objHeader.svcTrncId = "/air/ols/reserve/rsvTust/rsvTustEnNmDict/detectEnNmTypo/logging/v1.00";		// 헤더_서비스 처리_서비스거래ID
	this.gfn_callTran(this, sSvcId, sSvcUrl, sInDs, sOutDs, sArg, sCallbackFunc, objHeader);	
};

this.AIRA0SLE1160M030_ontimer = function(obj:nexacro.Form,e:nexacro.TimerEventInfo)
{
	if(e.timerid == 90890)
	{
		this.killTimer(e.timerid);
		this.divPaxInfo.form.stc02.set_text("");
		this.divPaxInfo.form.stc02.set_visible(false);
	}
};

this.grdBdngInfo_onexpandup = function(obj:nexacro.Grid,e:nexacro.GridMouseEventInfo)
{
	// 팝업
	var nIdx = obj.getCellPos();
 	var vText = obj.getCellProperty("body", nIdx, "text");
 	var vColumuid = vText.substr( vText.lastIndexOf(":") + 1);

	if( vColumuid == 'tustCntryNm' ){
	    var sCntryCd = this.ds_BdngInfo.getColumn( e.row, 'tustCntryCd' );
		this.bfn_cntryPopup(this, {search:sCntryCd, sFunction:'', sFunction2:'fn_cntryPopup1'});
	}else if( vColumuid == 'tustPsptPublCntryNm' ){
	    var sCntryCd = this.ds_BdngInfo.getColumn( e.row, 'tustPsptPublCntryCd' );
		this.bfn_cntryPopup(this, {search:sCntryCd, sFunction:'', sFunction2:'fn_cntryPopup2'});
	}
};

/***************************************************************************
 * 함  수  명   : fn_cntryPopup1
 * 기      능   : 팝업창에서 데이터를 선택했을 시 실행
 * 인      자   : objDs       : 리턴 데이터셋
                  nRow        : 선택한 로우
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_cntryPopup1 = function(objDs, nRow)
{
	var pRow = this.ds_BdngInfo.rowposition;
	
	if( nRow > -1 ){
		this.ds_BdngInfo.setColumn(pRow, "tustCntryCd", objDs.getColumn(nRow, "code"));
		this.ds_BdngInfo.setColumn(pRow, "tustCntryNm", objDs.getColumn(nRow, "codeNm"));
	}
};
/***************************************************************************
 * 함  수  명   : fn_cntryPopup2
 * 기      능   : 팝업창에서 데이터를 선택했을 시 실행
 * 인      자   : objDs       : 리턴 데이터셋
                  nRow        : 선택한 로우
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_cntryPopup2 = function(objDs, nRow)
{
	var pRow = this.ds_BdngInfo.rowposition;
	
	if( nRow > -1 ){
		this.ds_BdngInfo.setColumn(pRow, "tustPsptPublCntryCd", objDs.getColumn(nRow, "code"));
		this.ds_BdngInfo.setColumn(pRow, "tustPsptPublCntryNm", objDs.getColumn(nRow, "codeNm"));
	}
};
//승객정보 컬럼이 변경된 후 처리
this.ds_BdngInfo_oncolumnchanged = function(obj:nexacro.NormalDataset,e:nexacro.DSColChangeEventInfo)
{
		//여권만료일자
	if (e.columnid == 'tustPsptExpyDt') {
		var tustPsptExpyDt = this.ds_BdngInfo.getColumn(e.row, 'tustPsptExpyDt'); // 여권만료일자
		var depDt = this.parent.parent.parent.parent.ds_lastItnrFlgt.getColumn(0, "deptDate"); 
		if ('' != this.nullToString(tustPsptExpyDt)) {
			if (8 != tustPsptExpyDt.length && 8 != depDt.length) return;
			this.ds_BdngInfo.setColumn(e.row, 'tustPsptExpyDtYn','Y');
			if (180 > this.gfn_getDiffDate(depDt, tustPsptExpyDt)) {
				this.ds_BdngInfo.setColumn(e.row, 'tustPsptExpyDtYn','N');
				this.gfn_alert(this, "IUIAIR100525", ["",""],"", "fn_msgCallback", "validFail");	// IUIAIR100525 : 여권만료일이 출발일 기준 6개월 미만입니다.
			}
		}
	}	
	//NDC일때 한글 성명이 변경되면 체류지 정보에 탑승객명을 넣어준다.
	if(e.columnid == 'paxLclName'){
		if(this.tmpresNcstYn ==='Y' && (this.fareTypeNdc==='N' || this.fareTypeNdc==='R')){
			this.ds_stayList.setColumn(e.row,'paxLclName',e.newvalue);
		}
	}
};

this.nullToString = function(value) {
	if (undefined == value || null == value) return '';
	else return value;
}

//체류지정보 팝업 오픈
this.divPaxInfo_div03_grdStay_oncellclick = function(obj:nexacro.Grid,e:nexacro.GridClickEventInfo)
{
	this.stayRow = e.row;
	if(e.cell==3){//거주국가
		var sCntryCd = this.ds_stayList.getColumn(this.stayRow,"curRsplCntryCd");
		var sFunction2 = "fn_afterCntryPopup";
		var objArgument     = {search:sCntryCd, sFunction2:sFunction2};
		this.bfn_cntryPopup(this, objArgument);
    }else if(e.cell==7){//체류도시팝업
		var sCityCd = this.ds_stayList.getColumn(this.stayRow,"stayCityCd");
		this.bfn_srchComCityPopup(sCityCd,"fn_afterCityCntryStateCnt");
    }	
};
// 거주국가 팝업창에서 데이터를 선택했을 시 실행
this.fn_afterCntryPopup = function(objDs, nRow)
{
    if( nRow > -1 ){
        this.ds_stayList.setColumn(this.stayRow,"curRsplCntryCd",objDs.getColumn(nRow, "code"));
    }
};

/***************************************************************************
 * 함  수  명   : fn_afterCityCntryStateCnt
 * 기      능   : 체류 도시 조회된 건수가 1이 아닐경우 팝업창을 띄우고 검색어를 팝업창에 전달
 * 인      자   : objDs       : 리턴 데이터셋
                  objArgument : 리턴 오브젝트
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_afterCityCntryStateCnt = function(objDs, objArgument)
{
    var pRow = this.stayRow;
	this.ds_stayList.setColumn(pRow, "stayCityEnNm", this.ds_rtnCityList.getColumn(0,"cityNm"));
	this.ds_stayList.setColumn(pRow, "stayCityCd", this.ds_rtnCityList.getColumn(0,"cityCd"));
	this.ds_stayList.setColumn(pRow, "stayScod", this.ds_rtnCityList.getColumn(0,"scod"));
	this.ds_stayList.setColumn(pRow, "stayStateEnNm", this.ds_rtnCityList.getColumn(0,"scod"));
	this.ds_stayList.setColumn(pRow, "stayCntryCd", this.ds_rtnCityList.getColumn(0,"cntryCd"));
};

this.tab_reqMng_Tabpage_stayInfo_btn_copy_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var size = this.ds_stayList.getRowCount();
    var curRsplCntryCd = this.ds_stayList.getColumn(0,"curRsplCntryCd"); /*거주국가*/
    var stayCntryCd = this.ds_stayList.getColumn(0,"stayCntryCd"); /*체류국가*/
	var stayScod = this.ds_stayList.getColumn(0,"stayScod"); /*체류주*/
    var stayStateCd = this.ds_stayList.getColumn(0,"stayStateEnNm"); /*체류주State*/
    var stayCityCd = this.ds_stayList.getColumn(0,"stayCityCd"); /*체류도시*/
	var stayCityEnNm = this.ds_stayList.getColumn(0,"stayCityEnNm"); /*체류도시명*/
    var tmpresEnAdrs = this.ds_stayList.getColumn(0,"tmpresEnAdrs"); /*체류지주소*/
    var tmpresZip = this.ds_stayList.getColumn(0,"tmpresZip"); /*우편번호*/
    
    for(var i=1;i<size;i++){
        this.ds_stayList.setColumn(i,"curRsplCntryCd",curRsplCntryCd);
        this.ds_stayList.setColumn(i,"stayCntryCd",stayCntryCd);
		this.ds_stayList.setColumn(i,"stayScod",stayScod);
        this.ds_stayList.setColumn(i,"stayStateEnNm",stayScod);
        this.ds_stayList.setColumn(i,"stayCityCd",stayCityCd);
		this.ds_stayList.setColumn(i,"stayCityEnNm",stayCityEnNm);
        this.ds_stayList.setColumn(i,"tmpresEnAdrs",tmpresEnAdrs);
        this.ds_stayList.setColumn(i,"tmpresZip",tmpresZip);
    }
};
/***************************************************************************
 *NDC용 처리 function추가 
 ***************************************************************************/
this.fn_ndcFormInit = function(){
	// 발행일 노출 및 기본 세팅
	if(this.fareTypeNdc != "N" && this.fareTypeNdc != "R")return;
	this.divPaxInfo.form.div01.form.grdBdngInfo.setFormatColProperty(8, "size", 120);
	this.divPaxInfo.form.div01.form.grdBdngInfo.setFormatColProperty(9, "size", 120);
	this.divPaxInfo.form.div_btn.form.stc00.set_visible(false);
	this.divPaxInfo.form.stc03.set_visible(true);
	
	if(this.fareTypeNdc=="R" && this.fn_ndcFareIdFind('apisEditable')=="N" && this.fn_ndcFareIdFind('voidAble')=="N"){
		this.divPaxInfo.form.div_btn.form.stc00.set_visible(true);
		var msg1 = "* 예약 후에는 입력하신 모든 정보 수정이 불가능하오니 유의하시기 바랍니다.\n* 결제 후 즉시 환불수수료가 발생되며, 예약변경이 불가능합니다.";
		this.divPaxInfo.form.stc03.set_text(msg1);
		this.divPaxInfo.form.stc03.set_color("red");
	}else if(this.fareTypeNdc=="R" && this.fn_ndcFareIdFind('apisEditable')=="Y" && this.fn_ndcFareIdFind('voidAble')=="Y"){
		this.divPaxInfo.form.div_btn.form.stc00.set_visible(true);
		this.divPaxInfo.form.stc03.set_visible(false);
	}else if(this.fareTypeNdc=="R" && this.fn_ndcFareIdFind('apisEditable')=="N" && this.fn_ndcFareIdFind('voidAble')=="Y"){
		this.divPaxInfo.form.div_btn.form.stc00.set_visible(true);
		var msg1 = "* 예약 후에는 입력하신 모든 정보 수정이 불가능하오니 유의하시기 바랍니다.";
		this.divPaxInfo.form.stc03.set_text(msg1);
		this.divPaxInfo.form.stc03.set_color("red");
	}else if(this.fareTypeNdc=="R" && this.fn_ndcFareIdFind('apisEditable')=="Y" && this.fn_ndcFareIdFind('voidAble')=="N"){
		this.divPaxInfo.form.div_btn.form.stc00.set_visible(true);
		var msg1 = "* 결제 후 즉시 환불수수료가 발생되며, 예약변경이 불가능합니다.";
		this.divPaxInfo.form.stc03.set_text(msg1);
		this.divPaxInfo.form.stc03.set_color("red");
	}
}

//선택한 스케줄과 원본스케줄 fareId비교하여 컬럼값 찾기
this.fn_ndcFareIdFind = function(columnId){
	var returnData = "";
	var lastItnrFlgt = this.bfn_rsvUpperGetComp( "AIRA0SLE1160M020" ).ds_lastItnrFlgt;
	var originalSrchFarLstOut = this.getOwnerFrame().form.div_work.form.ds_originalSrchFarLstOut;
	
	for(var i=0; i< originalSrchFarLstOut.getRowCount(); i++){
		var fareId = this.getOwnerFrame().form.div_work.form.ds_originalSrchFarLstOut.getColumn(i,'fareId');
		var lastFareId = lastItnrFlgt.getColumn(0,'fareId');
		
		if(fareId === lastFareId){
			returnData = originalSrchFarLstOut.getColumn(i,columnId);
			break;
		}
	}	
	return returnData
}


/***************************************************************************
 * 함  수  명   : fn_ndcBdngInfoGridChange
 * 기      능   : NDC 탑승객 정보 입력 그리드 변경
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_ndcBdngInfoGridChange = function()
{
	//gird교체 //NDC이면 탑승객정보 
	this.divPaxInfo.form.div01.form.removeChild("grdBdngInfo");
	var grid = this.grdBdngInfo;//NDC gird
	var oldParent = this.grdBdngInfo.parent;//grid부모
		oldParent.removeChild(this.grdBdngInfo.name);//NDC gird 삭제
	var newdiv01= this.divPaxInfo.form.div01.form;//NDC gird를 넣을 기존 DIV
	grid.set_left(0);   // 새로운 x 좌표
	grid.set_top(0);    // 새로운 y 좌표
	newdiv01.addChild(grid.name, grid);//NDC그리드 div01에 추가
	grid.setFormatColProperty(9, "size", 120);
	grid.set_visible(true);
}
/***************************************************************************
 * 함  수  명   : fn_ndcStayInfoGridShow
 * 기      능   : NDC 체류지정보 넣기
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_ndcStayInfoGridShow = function(BdngInfoCnt)
{
	if(this.tmpresNcstYn !='Y'){
		return 0;
	}
	
	//체류지정보 show
	this.divPaxInfo.form.div03.form.stcStayInfo.set_visible(true);
	this.divPaxInfo.form.div03.form.grdStay.set_visible(true);	
	this.divPaxInfo.form.div03.form.btn_copy.set_visible(true);	
	
	//체류지정보만큼 넓이기
	var stayInfoHeight = 35;
	this.divPaxInfo.form.div03.form.stcStayInfo.set_height(stayInfoHeight);
	this.divPaxInfo.form.div03.form.grdStay.set_height(32+(24*parseInt(BdngInfoCnt))+2);
	this.divPaxInfo.form.div03.setOffsetHeight(10+stayInfoHeight + this.divPaxInfo.form.div03.form.grdStay.getOffsetHeight());
	/*this.divPaxInfo.form.div03.setOffsetWidth(1002);*/
	
	for(var i = 0; i < parseInt(BdngInfoCnt); i++) {
		this.ds_stayList.addRow();
		this.ds_stayList.setColumn(i,'curRsplCntryCd','KR');
	}

	return this.divPaxInfo.form.div03.getOffsetHeight();
}

//여권정보 확인
this.fn_patpostChk = function(){
	var isValidFail = false;
	for (var i=0 ; i < this.ds_BdngInfo.rowcount ; i++) {
		status = this.ds_BdngInfo.getColumn(i, "romaStatus");
		if(status == 1 || status == 2) {
			isValidFail = true;
		}
	}
	return isValidFail
}

//여권정보 메세지 처리 
this.fn_ndcpatpostMsg = function(sMsg){
	var isValidFail = this.fn_patpostChk();
	var fail_message = "실제 여권 정보와 영문 성 또는 영문 이름이 일치하지 않습니다.\n여권에 기재된 영문 성명과 일치하는지 반드시 확인 후 진행해 주세요.\n예약/결제 이후에는 정보 수정이 불가할 수 있습니다.";
	if(isValidFail){
		this.gfn_confirm(this, fail_message, ["", ""], "", function (sId, sVal){
			if(sVal){
				this.fn_ndcSaveMsg(sMsg);				
			}
		})
	}else{
		this.fn_ndcSaveMsg(sMsg);
	}
}
//NDC 저장 메세지 처리 
this.fn_ndcSaveMsg = function(sMsg){
	var ndcMsg = "항공사에서 직접 제공하는 요금으로 예약 후\n"+
		"탑승객명,여권,체류지 등 모든 정보 수정\n"+
		"이 불가합니다.\n"+
		"2인 이상 예약 시  일정 변경 및 취소, 환불은\n"+
		"전체 승객이 함께 진행되어야 합니다.\n"+
		"계속 진행하시겠습니까?";
	if(this.getOwnerFrame().form.div_work.form.fv_airFarCombYn=="Y"){
		this.gfn_confirm(this, sMsg, ["", ""], "C", function (sId, sVal)
		{
			if(sVal) {
				this.gfn_confirm(this, ndcMsg, ["", ""], "", function (sId, sVal){	//ndc이면 예약메세지 띄우기 
					if(sVal) {
						this.fn_agtTelYnChk();
					}
				})	
			}
		});
	}else{
		this.gfn_confirm(this, "IUIAIR100752", ["", ""], "C", function (sId, sVal)
		{
			if(sVal) {
				this.gfn_confirm(this, ndcMsg, ["", ""], "", function (sId, sVal){	//ndc이면 예약메세지 띄우기 
					if(sVal) {
						this.fn_agtTelYnChk();
					}
				})	
			}
		});
	}
}

//누아 저장 메세지 처리 
this.fn_nuuaSaveMsg = function(sMsg){
	var nuuaMsg = "본 항공권은 항공사 직판 운임으로, 예약생성 후 10분 내 미결제 시 예약이 자동 취소됩니다.진행하시겠습니까?";
	if(this.getOwnerFrame().form.div_work.form.fv_airFarCombYn=="Y"){
		this.gfn_confirm(this, sMsg, ["", ""], "C", function (sId, sVal)
		{
			if(sVal) {
				this.gfn_confirm(this, nuuaMsg, ["", ""], "", function (sId, sVal){	//ndc이면 예약메세지 띄우기 
					if(sVal) {
						this.fn_agtTelYnChk();
					}
				})	
			}
		});
	}else{
		this.gfn_confirm(this, "IUIAIR100752", ["", ""], "C", function (sId, sVal)
		{
			if(sVal) {
				this.gfn_confirm(this, nuuaMsg, ["", ""], "", function (sId, sVal){	//ndc이면 예약메세지 띄우기 
					if(sVal) {
						this.fn_agtTelYnChk();
					}
				})	
			}
		});
	}
}


/***************************************************************************
 * 함  수  명   : fn_ocrWbsOpen
 * 기      능   : OCR
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_ocrWbsOpen = function()
{
	//ORC 영역 활성화
	this.divPaxInfo.form.wbs_ocr.set_visible(true);
	
	// webBrowser 컴포넌트에 지도 로딩을 위한 페이지 연결
    var serverState = nexacro.getApplication().gv_sSvrType;
    var url = "http://127.0.0.1:4098";
	
    if(serverState == 'DEV') {
    	url = nexacro.getApplication().Tran.webUrl.DEV;
    } else if(serverState == 'STG') {
    	url = nexacro.getApplication().Tran.webUrl.STG;
    } else if(serverState == 'QA') {
    	url = nexacro.getApplication().Tran.webUrl.QA;
    } else if(serverState == 'REAL') {
    	url = nexacro.getApplication().Tran.webUrl.REAL;
    }
    
	url += "/expansion/ocr/ocr.html?division=passport&channelCode=AIR-HUB";
	
    this.divPaxInfo.form.wbs_ocr.set_url(url);
}

this.divPaxInfo_wbs_ocr_onusernotify = function(obj:nexacro.WebBrowser,e:nexacro.WebUserNotifyEventInfo)
{
	var returnMsg = "";
	var errorMsg = "";
    var dataStr = e.userdata;
	var dataArray = JSON.parse(dataStr);
	var cnt = 0;
	var totalCnt = 0;
	var unmatchedCnt = 0;
	
	var currentRow = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div01.form.grd01.currentrow;
	var depDate = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(currentRow, "deptDate");
	
	//row전체 데이터 삭제 (여권판독중 중복데이터 들어가는 이슈)
	for (var i = 0; i < this.ds_BdngInfo.rowcount; i++) {
		this.ds_BdngInfo.setColumn(i, "paxLclName", "");
		this.ds_BdngInfo.setColumn(i, "paxLastName", "");
		this.ds_BdngInfo.setColumn(i, "paxFirstName", "");
		this.ds_BdngInfo.setColumn(i, "gender", 0);
		this.ds_BdngInfo.setColumn(i, "birthDay", "");
		this.ds_BdngInfo.setColumn(i, "tustPpn", "");
		this.ds_BdngInfo.setColumn(i, "tustPsptExpyDt", "");
		this.ds_BdngInfo.setColumn(i, "tustCntryCd", "KR");
		this.ds_BdngInfo.setColumn(i, "tustCntryNm", "한국");
		this.ds_BdngInfo.setColumn(i, "tustPsptPublCntryCd", "KR");
		this.ds_BdngInfo.setColumn(i, "tustPsptPublCntryNm", "한국");
	}
	
	// 예: 1개씩 출력
    for (var i = 0; i < dataArray.length; i++) {
		totalCnt++;
	    var item = dataArray[i];
		
		if(item.error){
			errorMsg+="["+i+"]\n- 에러코드 : "+item.errorCode+"\n- 에러메세지 : "+item.errorMsg+"\n- 에러디테일 : "+item.errorDetails+"\n- 파일명 : "+item.file+"\n\n";
			continue;
		}
		
        var passport = item.passportAnalysis.passport;				/*여권 번호*/
		var surname = item.passportAnalysis.surname;				/*성 (영문)*/
		var given = item.passportAnalysis.given;					/*이름 (영문)*/
		var birth = nexacro.replaceAll(item.passportAnalysis.birth,"/","");					/*생년월일 (YYYY/MM/DD)*/
		var sex = item.passportAnalysis.sex;						/*성별 (M/F)*/
		var issue = item.passportAnalysis.issue;					/*여권 발급일 (YYYY/MM/DD)*/
		var expiry = nexacro.replaceAll(item.passportAnalysis.expiry, "/", "");					/*여권 만료일 (YYYY/MM/DD)*/
		var korean = item.passportAnalysis.korean;					/*성명 (한글)*/
		var issuingCountry = item.passportAnalysis.issuingCountry;	/*발행국*/
		var nationality = item.passportAnalysis.nationality;		/*국적*/
		var issuingCountryCode = item.passportAnalysis.issuingCountryCode;	/*발행국 국가코드*/
		var nationalityCode = item.passportAnalysis.nationalityCode;	/*국적 국가코드*/
		var issuingCountryKorean = item.passportAnalysis.issuingCountryKorean;	/*발행국 한글명*/
		var nationalityKorean = item.passportAnalysis.nationalityKorean;	/*국적 한글명*/
		var validPassport = item.passportAnalysis.validPassport;	/*여권 유효 여부 (true: 유효, false: 무효)*/
		var validation = item.passportValidation.validationResult;
		
		if(issuingCountryKorean=="대한민국"){
			issuingCountryKorean="한국";
		}
		
		if(nationalityKorean=="대한민국"){
			nationalityKorean="한국";
		}
		
		var depAge = this.getAgeAndMonths(depDate, birth);
		
		if(validPassport){
			for(var j = 0; j < this.ds_BdngInfo.rowcount; j++){
				if(!this.gfn_isNull(this.ds_BdngInfo.getColumn(j, "paxLclName"))){
					continue; // 이미 값이 있으면 건너뜀
				}
				
				var isValid = false;
				if(this.ds_BdngInfo.getColumn(j, "ageType") == "C"){
					//아동
					if (depAge.months >= 24 && depAge.age < 12) {
						isValid = true;
						console.log("아동",depAge);
					}
				}else if(this.ds_BdngInfo.getColumn(j, "ageType") == "I"){
					//유아
					if(depAge.months < 24){
						isValid = true;
						console.log("유아",depAge);
					}
				}else if(this.ds_BdngInfo.getColumn(j, "ageType") == "A"){
					//성인
					if(depAge.age >= 12){
						isValid = true;
						console.log("성인",depAge);
					}
				}
				
				if (isValid) {
					this.ds_BdngInfo.setColumn(j, "paxLclName", korean);
					this.ds_BdngInfo.setColumn(j, "paxLastName", surname);
					this.ds_BdngInfo.setColumn(j, "paxFirstName", given);
					this.ds_BdngInfo.setColumn(j, "gender", sex);
					this.ds_BdngInfo.setColumn(j, "birthDay", birth);
					this.ds_BdngInfo.setColumn(j, "tustPpn", passport);
					this.ds_BdngInfo.setColumn(j, "tustPsptExpyDt", expiry);
					this.ds_BdngInfo.setColumn(j, "tustCntryCd", nationalityCode);
					this.ds_BdngInfo.setColumn(j, "tustCntryNm", nationalityKorean);
					this.ds_BdngInfo.setColumn(j, "tustPsptPublCntryCd", issuingCountryCode);
					this.ds_BdngInfo.setColumn(j, "tustPsptPublCntryNm", issuingCountryKorean);
					
					cnt++;
					
					break;
				}else{
					unmatchedCnt++;
				}
			}
		}
	}
	
	var msg = "";
	
	if(totalCnt==cnt){
		msg = "AI여권인식을 성공하셨습니다.\n여권검증결과를 반드시 확인해주세요.\n(단, 외국인여권은 검증불가)";
	}else if(unmatchedCnt > 0){
		msg = "선택한 탑승객의 나이구분이 여권의 생년월일과 일치하지 않습니다.\n(성인/아동/유아)\n재확인 후 시도해주세요.";
	}else{
		msg = "AI여권인식을 실패한 파일이 있습니다.\n성공한 여권만 처리되오니, 검증결과를 확인해주세요.";
	}
	
	this.gfn_alert(this, msg, "", "");
};

this.getAgeAndMonths = function(yyyymmdd, birthday){
    var stdY = parseInt(String(yyyymmdd).substring(0,4), 10);
    var stdM = parseInt(String(yyyymmdd).substring(4,6), 10);
    var stdD = parseInt(String(yyyymmdd).substring(6,8), 10);

    var birthY = parseInt(String(birthday).substring(0,4), 10);
    var birthM = parseInt(String(birthday).substring(4,6), 10);
    var birthD = parseInt(String(birthday).substring(6,8), 10);

    var stdDate = new Date(stdY, stdM - 1, stdD);
    var birthDate = new Date(birthY, birthM - 1, birthD);

    // 만 나이 계산
    var age = stdY - birthY;
    if (stdM < birthM || (stdM === birthM && stdD < birthD)) {
        age--;
    }

    // 개월 수 계산
    var months = (stdDate.getFullYear() - birthDate.getFullYear()) * 12 + (stdDate.getMonth() - birthDate.getMonth());
    if (stdDate.getDate() < birthDate.getDate()) {
        months--;
    }

    return { age: age, months: months };
}
]]></Script>
