    <Script type="xscript5.1"><![CDATA[/***************************************************************************
 * Program ID    : AIRA0SLE1160M030
 * Program Name  : 아피스입력
 * Author        : A01585
 * Created Date  : 2019.04.17
 *
 * =========================================================================
 * 수정일자     수정자    내    용
 * =========================================================================
 * 2019.04.17   A01585    최초작성
 **************************************************************************/
 
//**************************************************************************
// [ PART 1 ] Form에서 Include 할 라이브러리(xjs)파일 정의
//**************************************************************************
include "Biz_AIR_JS::AirCommon.xjs";
include "Biz_BZC_JS::BzcCommon.xjs";
include "Biz_AIR_JS::RsvCommon.xjs";
include "Biz_HUB_JS::HubCommon.xjs";

//**************************************************************************
// [ PART 2 ] Form에서 사용될 전역변수를 선언
//**************************************************************************
this.fv_cboSiteCatsIdx = 0; //법인예약 콤보박스 선택 idx
this.fv_cboMgrIdx = 0; //웹사이트지정 하나허브 콤보박스 선택 idx
this.fv_cboHomePageIdx = 0; //웹사이트지정 홈페이지 콤보박스 선택 idx
this.fv_cboDotComIdx = 0; //웹사이트지정 닷컴 콤보박스 선택 idx
this.fv_cboCallCenterIdx = 0; //웹사이트지정 콜센터 콤보박스 선택 idx
this.fv_payTypeGap = 0; //결제방식 영역(divPayType)이 예약정보(div00) 아래로 내려온 높이(px)
//NDC 추가 함수
this.fareTypeNdc = this.getOwnerFrame().form.div_work.form.ds_lastChcItnrFarAmt.getColumn(0, "apiSupCode");//M:아마데우스, G:갈릴레오, B:세이버, I:에어아시아, V:하나투어 인벤토리(RT), N:NDC, R:누아(NUUA)
this.fv_ndcOldCell = "";//grid이전 cell정보
this.stayRow = 0;
this.bdngIndex = 0;
this.lastArrAptCode = ""
this.tmpresNcstYn=""; //체류지등록여부
this.areaGubun = "N"; //지역구분
this.tustGubun = "N"; //여권구분
//NDC 끝
//**************************************************************************
// [ PART 3 ] Form Event 정의
//**************************************************************************
this.form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	// 화면 초기화를 위한 공통함수 호출(필수)
	this.gfn_formOnLoad(obj);
	//NDC관련
	this.divPaxInfo.form.div01.addEventHandler("onsize", this.resizeGrid, this);
};
//NDC관련
this.resizeGrid = function()
{
    var grid = this.divPaxInfo.form.div01.form.grdBdngInfo; // grdBdngInfo 그리드의 ID입니다.
    if (grid) {
        grid.set_width(this.divPaxInfo.form.div01.getOffsetWidth());
        //grid.set_height(this.divPaxInfo.form.div01.getOffsetHeight());
    }
};
//**************************************************************************
// [ PART 4 ] 사용자정의함수 정의
//**************************************************************************
/***************************************************************************
 * 함  수  명   : fn_formInit
 * 기      능   : 개발자정의 폼 초기화
 * 인      자   : obj 		- Form Object
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_formInit = function(obj:nexacro.Form)
{
	//전역번수 초기화
	this.fv_cboSiteCatsIdx = 0; //법인예약 콤보박스 선택 idx
	this.fv_cboMgrIdx = 0; //웹사이트지정 하나허브 콤보박스 선택 idx
	this.fv_cboHomePageIdx = 0; //웹사이트지정 홈페이지 콤보박스 선택 idx
	this.fv_cboDotComIdx = 0; //웹사이트지정 닷컴 콤보박스 선택 idx
	this.fv_cboCallCenterIdx = 0; //웹사이트지정 콜센터 콤보박스 선택 idx
		
	this.divPaxInfo.form.div00.form.rdoSite.set_value("MGR");
	this.divPaxInfo.form.div02.form.rdoAirRuleAgreeY.set_value("Y");
	
	this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(false); //화면 진입 시 웹사이트 하나허브 & 콤보박스 미노출
	this.divPaxInfo.form.div00.form.cboSiteMgr.set_value(1);
	
	//예약구분상세 영역 제거
	this.divPaxInfo.form.div02.setOffsetHeight(27);
	
	//일반이벤트 정보 설정
	this.ds_itnrListTemp01.copyData(this.getOwnerFrame().form.div_work.form.ds_itnrListTemp01);
	
	//예약정보 입력 화면 초기 높이 설정
	var bizPurposeHeight = this.divPaxInfo.form.div02.getOffsetHeight();
	this.divPaxInfo.form.div02.setOffsetHeight(bizPurposeHeight);
	var paxInfoDiv01 = this.divPaxInfo.getOffsetHeight();
	this.divPaxInfo.setOffsetHeight(paxInfoDiv01);
	
	//승객정보 그리드 생성
	var adtCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "adtCnt");
	var chdCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "chdCnt");
	var infCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "infCnt");
	var pasnType = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "pasnType");
	
	//승객정보 설정
	this.fn_addBdngInfo(adtCnt, chdCnt, infCnt, pasnType);
	
	//웹사이트 지정 호출
	this.fn_siteCdList();
	
	//운임규정 서비스규정목록 조회
	this.fn_farRulesSvcRulList();
	
	//세금계산서 설정 조회
	this.fn_txinKndSrch();
	
	//로그인 대리점의 예약가능여부 조회 
	this.fn_checkRsvAvailInfo();
	
	//국가번호 공통
	this.fn_searchTelCntryCode();
	
	//RT 땡처리 항공일 경우에만 국적 col 노출(아닐시 감춤)
	/*
	if(this.getOwnerFrame().form.div_work.form.ds_lastChcItnrFarAmt.getColumn(0, "apiSupCode") != "V"){
		this.divPaxInfo.form.div01.form.grdBdngInfo.setFormatColProperty(9, "size", 0);
	}
	*/
	//NDC이면 실행
	this.fn_ndcFormInit();
	
	//미주일경우 지역구분값 "Y" 변경
	var lastItnrFlgt = this.bfn_rsvUpperGetComp("AIRA0SLE1160M020").ds_lastItnrFlgt;
	for(var i=0;i<lastItnrFlgt.rowcount;i++){
		var depCd = lastItnrFlgt.getColumn(i, "depAreaGrpCd");
		var arrCd = lastItnrFlgt.getColumn(i, "arrAreaGrpCd");
		var mktAlCode = lastItnrFlgt.getColumn(i, "mktAlCode");
				
		var codeList = ["ZH", "ZA", "Z8", "SU", "SC", "RG", "MU", "MF", "KC", "HY", "HU", "GS", "FM", "CZ", "CA", "AR", "3U"];
		
		//미주지역(H1)이면서 해당항공사일경우
		if (depCd == "H1" || arrCd == "H1" || codeList.indexOf(mktAlCode) > -1) {
			this.areaGubun = "Y";
			break;
		}
	}
	
	for(var i=0;i<this.ds_BdngInfo.rowcount;i++){
		this.ds_BdngInfo.setColumn(i,"tustCntryCd","KR");
		this.ds_BdngInfo.setColumn(i,"tustCntryNm","한국");
		this.ds_BdngInfo.setColumn(i,"tustPsptPublCntryCd","KR");
		this.ds_BdngInfo.setColumn(i,"tustPsptPublCntryNm","한국");			
	}
	
	//넥사크로 브라우저 왜 다른 브라우저들일경우만 실행
	if(system.navigatorname != "nexacro"){
		this.fn_ocrWbsOpen();
	}
};

