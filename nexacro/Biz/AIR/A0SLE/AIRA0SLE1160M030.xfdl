								//this.gfn_alert(this, "성인예약입니다. 생년월일을 정확히 입력해주세요.");
								this.gfn_alert(this, "IUIAIR100747", ["", ""], "I", "", "IUIAIR100747");
								adtAge = false;
								return false;
							} else {
								adtAge = false; //청소년 팝업 미노출
							}
						}
					} else if(this.ds_BdngInfo.getColumn(i, "ageType") == "C") {
						trace("아동 나이 체크");
						if(!this.gfn_isNull(depDate)){
							//출국일 기준 예약불가
							if( !(parseInt(depAge) >= 2 && parseInt(depAge) < 12)) {
							trace("즉시결제_출국일 기준 아동 만 12세 초과");
								this.gfn_alert(this, "IUIAIR101740", ["", ""], "I", "", ""); //유아/소아 나이를 확인해주세요.\n출발일/귀국일 기준 유아는 만 2세 미만,\n소아는 만 12세 미만이어야 합니다.
								return false;
							}
						}
						
						if(!this.gfn_isNull(arrDate)){
							//귀국일 기준 아동 나이 구분 변경 안내 체크
							if( !(parseInt(arrAge) >= 2 && parseInt(arrAge) < 12)) {
							trace("즉시결제_귀국일 기준 아동 만 12세 초과");
								this.gfn_alert(this, "IUIAIR101740", ["", ""], "I", "", ""); //유아/소아 나이를 확인해주세요.\n출발일/귀국일 기준 유아는 만 2세 미만,\n소아는 만 12세 미만이어야 합니다.
