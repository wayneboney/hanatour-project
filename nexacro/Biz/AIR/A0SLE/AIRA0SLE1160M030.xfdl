				var currRow01 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div01.form.grd01.currentrow;
				depDate = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(currRow01, "deptDate");
				depAge = this.fn_compateAge(depDate, birthDay);
				var fareId = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(currRow01, "fareId");
				var filterVal = "fareId == '" + fareId + "' && itnrSeq == '2'";
				this.getOwnerFrame().form.div_work.form.ds_srchFarLstOut.filter(filterVal);
				arrDate = this.getOwnerFrame().form.div_work.form.ds_srchFarLstOut.getColumn(0, "deptDate");
				arrAge = this.fn_compateAge(arrDate, birthDay);
			}else{//그외
				var idxRow = eval("this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div0"+(j+1)+".form.grd0"+(j+1)+".currentrow");
				var depDateVal = eval("this.getOwnerFrame().form.div_work.form.ds_itnrList0"+(j+1)+".getColumn("+idxRow+", 'deptDate')");
				
				if(this.getOwnerFrame().form.div_work.form.ds_srchItnrLstOut.getRowCount() == 1){//편도
					depDate = depDateVal;
					
					depAge = this.fn_compateAge(depDate, birthDay);
				}else{//왕복, 다구간
					depDate = "";
					depAge = 0;
					arrDate = "";
					arrAge = 0;
					if(j < (this.getOwnerFrame().form.div_work.form.ds_srchItnrLstOut.getRowCount()-1)){
						depDate = depDateVal;
						
						depAge = this.fn_compateAge(depDate, birthDay);
					}else{
						arrDate = depDateVal;
						
						arrAge = this.fn_compateAge(arrDate, birthDay);
					}
				}
			}
			
			//성인, 아동, 유아 나이 구분 체크
			if(fareType != "V") { //RI(실시간)
			
				if(this.ds_BdngInfo.getColumn(i, "ageType") == "A") {
					if(!this.gfn_isNull(depDate)){
						//성인 예약자중 한명이라도 미성년 성인이 아닌 경우 청소년 팝업 미노출
						if(parseInt(depAge) >= 12 && parseInt(depAge) < 18) { //청소년 팝업 노출
							if(adtAge){
								adtAge = true;
							}
						} else if(!(parseInt(depAge) >= 12 && parseInt(depAge) < 18) && parseInt(depAge) < 18) { //12~17세를 제외한, 나머지 유효성 체크
							//this.gfn_alert(this, "성인예약입니다. 생년월일을 정확히 입력해주세요.");
							this.gfn_alert(this, "IUIAIR100747", ["", ""], "I", "", "IUIAIR100747");
							adtAge = false;
							return false;
						} else {
							adtAge = false; //청소년 팝업 미노출
						}
					}
					
				 } else if(this.ds_BdngInfo.getColumn(i, "ageType") == "C") {
