				  {
					//예약생성하기
					this.fn_resCreation();
				  }, "IUIAIR100751"
			);
		}else{
			//예약생성하기
			this.fn_resCreation();
		}
	}
};

/***************************************************************************
 * 함  수  명   : fn_fareAvailChk
 * 기      능   : 운임유효성조회
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_fareAvailChk = function()
{
	this.ds_fareAvailChkIn.clearData();
	this.ds_fareAvailChkIn.addRow();
	
	this.ds_fareAvailChkIn.setColumn(0, "fareId", this.parent.parent.parent.parent.ds_resCret.getColumn(0, "fareId"));
	
	// 공통Transaction 호출
	var sSvcId  		= "getFareAvailChk";
	var sSvcUrl  		= "svcUrl::";
	var sInDs   		= "body=ds_dumy:A body_fareAvailSrchInVo=ds_fareAvailChkIn";
	var sOutDs  		= "ds_headInfoOut=body_testHeadOutVo ds_returnBizComOut=body_returnBizComVo ds_fareAvailChkOut=body_fareAvailSrchFinalVo";

	var sArg 			= "";
	var sCallbackFunc 	= "fn_callBack";

	var objHeader       = this.bfn_rsvTranInit();
	
	objHeader.svcTrncId = "/air/ols/reserve/airMgr/air/fareavailsrch/getFareAvailSrch/v1.00";// 헤더_서비스 처리_서비스거래ID
	
	this.gfn_callTran(this, sSvcId, sSvcUrl, sInDs, sOutDs, sArg, sCallbackFunc, objHeader);
};

/***************************************************************************
