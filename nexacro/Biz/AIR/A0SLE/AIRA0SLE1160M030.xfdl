						if(!this.gfn_isNull(arrDate)){
							//귀국일 기준 예약 불가
							if(parseInt(arrAge) >= 2){
							trace("즉시결제_귀국일 기준 유아 만 2세 초과");
								this.gfn_alert(this, "IUIAIR101740", ["", ""], "I", "", ""); //유아/소아 나이를 확인해주세요.\n출발일/귀국일 기준 유아는 만 2세 미만,\n소아는 만 12세 미만이어야 합니다.
								return false;
							}
						}						
					}
					
				} else { //추후결제인 경우 : AS-IS LOGIC처리
				
					if(this.ds_BdngInfo.getColumn(i, "ageType") == "A") {					
						if(!this.gfn_isNull(depDate)){
							//성인 예약자중 한명이라도 미성년 성인이 아닌 경우 청소년 팝업 미노출
							if(parseInt(depAge) >= 12 && parseInt(depAge) < 18) { //청소년 팝업 노출
