/***************************************************************************
 * 함  수  명   : fn_compateAge
 * 기      능   : 특정날짜기준 만나이구하기(기준일,생일)
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_compateAge = function(yyyymmdd, birthday)
{
	var stdyyyy = String(yyyymmdd).substring(0,4);
	var stdmm = String(yyyymmdd).substring(4,6);
	var stddd = String(yyyymmdd).substring(6,8);
	
	var age = 0;
	
	var yyyy = parseInt(String(birthday).substring(0,4),10);
	var mmdd = String(birthday).substring(4,6) + String(birthday).substring(6,8);
	
	var d = new Date(stdyyyy,parseInt(stdmm)-1,stddd);
	var tmonth = d.getMonth()+1;
	var tdate = d.getDate();
	
	var today = ((tmonth < 10) ? String('0' + tmonth): String(tmonth)) + ((tdate < 10) ? String('0' + tdate):String(tdate));
	
	age = d.getFullYear() - yyyy + 1;
	
	if(today < mmdd) {
		age = age - 2;
	}else{
		age = age -1;
	}
	
	return age;
};

/***************************************************************************
 * 함  수  명   : fn_addBdngInfo
 * 기      능   : 승객정보 추가
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_addBdngInfo = function(adtCnt, chdCnt, infCnt, pasnType)
{
	var BdngInfoCnt = 0;
	this.ds_BdngInfo.clearData();
	//dataSet의 Column값이 변경된 후 발생하는 이벤트 제거
	this.ds_BdngInfo.removeEventHandler("oncolumnchanged", this.ds_BdngInfo_oncolumnchanged, this);
	for(var i = 0; i < parseInt(adtCnt); i++){
		this.ds_BdngInfo.addRow();
		this.ds_BdngInfo.setColumn(i, "ageType", "A");//고정
		this.ds_BdngInfo.setColumn(i, "ageTypeNm", "성인");//고정
		this.ds_BdngInfo.setColumn(i, "gender", 0);//고정
		this.ds_BdngInfo.setColumn(i, "pasnType", pasnType);
		
		//대표승객구분명 설정
		var pasnTypeNm = "";
		this.getOwnerFrame().form.div_work.form.ds_rprsPasnType.set_filterstr("comDtlCd == '"+pasnType+"'");
		pasnTypeNm = this.getOwnerFrame().form.div_work.form.ds_rprsPasnType.getColumn(0, "cdLtrs1Cont");
		
		this.ds_BdngInfo.setColumn(i, "pasnTypeNm", pasnTypeNm);
		BdngInfoCnt++;
	}
	for(var i = BdngInfoCnt; i < parseInt(adtCnt)+parseInt(chdCnt); i++){
		this.ds_BdngInfo.addRow();
		this.ds_BdngInfo.setColumn(i, "ageType", "C");//고정
		this.ds_BdngInfo.setColumn(i, "ageTypeNm", "아동");//고정
		this.ds_BdngInfo.setColumn(i, "gender", 0);//고정
		this.ds_BdngInfo.setColumn(i, "pasnType", "CHD");//고정
		this.ds_BdngInfo.setColumn(i, "pasnTypeNm", "아동");//고정
		BdngInfoCnt++;
	}
	for(var i = BdngInfoCnt; i < parseInt(adtCnt)+parseInt(chdCnt)+parseInt(infCnt); i++){
		this.ds_BdngInfo.addRow();
		this.ds_BdngInfo.setColumn(i, "ageType", "I");//고정
		this.ds_BdngInfo.setColumn(i, "ageTypeNm", "유아");//고정
		this.ds_BdngInfo.setColumn(i, "gender", 0);//고정
		this.ds_BdngInfo.setColumn(i, "pasnType", "INF");//고정
		this.ds_BdngInfo.setColumn(i, "pasnTypeNm", "유아");//고정
		BdngInfoCnt++;
	}
	
	var ndcHeigth = 0;
	var parseHeight = 24;
	var ndcParentDivHeight=0;
	var ndcStayDivHeight =0;
	var ndcTextStcHeight = 0;
	if(this.fareTypeNdc == 'N' || this.fareTypeNdc == 'R'){
		//gird교체 //NDC이면 탑승객정보
		ndcHeigth = 24; //NDC용 높이 추가
		parseHeight = 48;//NDC 예약자 등록 정보 높이 변경
		ndcParentDivHeight = 32*(parseInt(BdngInfoCnt));//부모 DIV01 높이 추가
		this.tmpresNcstYn = this.fn_ndcFareIdFind('tmpresNcstYn');//체류지 등록 확인
		this.fn_ndcBdngInfoGridChange();//승객정보 그리드 교체
		ndcStayDivHeight = this.fn_ndcStayInfoGridShow(BdngInfoCnt);//체류지 정보 그리드 생성
		ndcParentDivHeight = parseInt(ndcParentDivHeight)+parseInt(ndcStayDivHeight);
		ndcTextStcHeight = 75;
	}else{
		ndcHeigth = 24; //NDC용 높이 추가
		parseHeight = 48;//NDC 예약자 등록 정보 높이 변경
		ndcParentDivHeight = 32*(parseInt(BdngInfoCnt));//부모 DIV01 높이 추가
		ndcTextStcHeight = 75;
	}
	
	//결제방식 영역이 예약정보 아래로 내려온 높이 반영
	this.fn_adjustPayTypeGap();

	//예약정보 입력 화면 높이 설정
	this.divPaxInfo.form.div01.form.grdBdngInfo.setOffsetHeight(34+ndcHeigth+(parseHeight*parseInt(BdngInfoCnt))+2);
    this.divPaxInfo.form.div01.setOffsetHeight(37+ndcHeigth+(parseHeight*parseInt(BdngInfoCnt)));
    this.divPaxInfo.setOffsetHeight(291+ndcHeigth+ndcTextStcHeight+ndcStayDivHeight+(parseHeight*parseInt(BdngInfoCnt)-26+2)+this.fv_payTypeGap);
	
	//최종선택여정 화면 높이 설정
	this.parent.setOffsetHeight(parseInt(this.divPaxInfo.getOffsetHeight()));
	var parentDiv01 = this.parent.parent.parent.getOffsetHeight();
	this.parent.parent.parent.setOffsetHeight(parseInt(parentDiv01)+parseInt(this.parent.getOffsetHeight())+180);
	//검색결과 최종선택여정 영역 높이 설정
	this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.divLastChcItnr.setOffsetHeight(this.parent.parent.parent.getOffsetHeight());
	//운임조회 검색결과(우측) Div 높이 조정
	var div01Height = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.getOffsetHeight();
	
	this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.setOffsetHeight(div01Height+8+parseInt(ndcParentDivHeight)+ndcTextStcHeight);
	
	this.divPaxInfo.form.resetScroll();
	this.getOwnerFrame().form.div_work.form.div_cntnt.form.resetScroll();
	
	//승객정보 입력 그리드 첫행 선택
	this.ds_BdngInfo.set_rowposition(0);
	//dataSet의 Column값이 변경된 후 발생하는 이벤트 설정
	this.ds_BdngInfo.setEventHandler("oncolumnchanged", this.ds_BdngInfo_oncolumnchanged, this);
};
/***************************************************************************
 * 함  수  명   : fn_checkBirthDate
 * 기      능   : 생년월일 유효성 검증
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_checkBirthDate = function(val, index) 
{
	var birthDate = val; //법정생년월일
		
	if(birthDate == "") return true;
	 
	var yy = birthDate.substring(0,4);
	var mm = birthDate.substring(4,6);
	var dd = birthDate.substring(6,8);

	if(mm < "10") {
		mm = mm.substring(1);
	}
	if(dd < "10") {
		dd = dd.substring(1);
	}

	var ny = parseInt(yy);
	var nm = parseInt(mm);
	var nd = parseInt(dd);

	if(!(parseInt(yy)) || (ny < 1000) || (ny > 9999)) {
		//this.gfn_alert(this, "생년월일의 년도 입력이 잘못되었습니다.", "", "I", function()
		this.gfn_alert(this, "IUIAIR100753", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "birthDay", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "birthDay"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100753"
		);
		return false;
	}

	if(!(parseInt(mm)) || (nm < 1) || (nm > 12)) {
		//this.gfn_alert(this, "생년월일의 월 입력이 잘못되었습니다.", "", "I", function()
		this.gfn_alert(this, "IUIAIR100754", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "birthDay", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "birthDay"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100754"
		);
		return false;
	}

	var arr_d = new Array("31","28","31","30","31","30","31","31","30","31","30","31")

	//윤년계산
	if(((ny % 4 == 0)&&(ny % 100 !=0)) || (ny % 400 == 0)) arr_d[1] = 29;
	if(!(parseInt(dd)) || (nd < 1) || (nd > arr_d[nm-1])) {
		//this.gfn_alert(this, "생년월일의 일자 입력이 잘못되었습니다.", "", "I", function()
		this.gfn_alert(this, "IUIAIR100755", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "birthDay", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "birthDay"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100755"
		);
		return false;
	}

	var today = new Date();

	var year = today.getFullYear();
	var month = today.getMonth()+1;
	var day = today.getDate();
	if(month < 10) {
		month = "0" + month;
	}

	if(day < 10) {
		day = "0" + day;
	}
	
	var todayStr = year + "" + month + "" + day;
	
	if(parseInt(birthDate) > parseInt(todayStr)) {
		//this.gfn_alert(this, "생년월일은 오늘날짜 이전으로 입력하셔야 합니다.", "", "I", function()
		this.gfn_alert(this, "IUIAIR100756", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "birthDay", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "birthDay"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100756"
		);
		return false;
	}
    
    return true;
};

/***************************************************************************
 * 함  수  명   : fn_addBdngInfo
 * 기      능   : 휴대폰 유효성 체크
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_checkPhone = function(val, index)
{
    var phone = val;
     
    //값이 없는 경우 통과
	if(this.gfn_isNull(phone)) return true;
	
	//휴대폰 형식 체크 (10자리 이상, 11자리 이하, 시작값이 01으로 시작)
	if( phone.substring(0, 2) != "01" || phone.length < 10 || phone.length > 11 ) {
		//this.gfn_alert(this, "휴대폰 형식이 잘못되었습니다\n(10자리 이상, 11자리 이하, 01X 형식으로 시작)", "", "I", function()
		this.gfn_alert(this, "IUIAIR100757", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "mobileNo", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "mobileNo"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100757"
		);
		return false;
	}
	
	if( !(phone.substring(0, 3) == "010" 
		|| phone.substring(0, 3) == "011"
		|| phone.substring(0, 3) == "016"
		|| phone.substring(0, 3) == "017"
		|| phone.substring(0, 3) == "018"
		|| phone.substring(0, 3) == "019")) {
		//this.gfn_alert(this, "휴대폰 형식이 잘못되었습니다\n(010, 011, 016, 017, 018, 019 형식으로 시작)", "", "I", function()
		this.gfn_alert(this, "IUIAIR100758", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "mobileNo", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "mobileNo"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100758"
		);
		return false;
	}
	
	return true;
};

/***************************************************************************
 * 함  수  명   : fn_checkEmail
 * 기      능   : 이메일 유효성 체크
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_checkEmail = function(val, index) 
{
	var email = val;
	
	//값이 없는 경우 통과
	if(this.gfn_isNull(email)) return true;
	
	var regExp = /^[0-9a-zA-Z]([-_\.]?[0-9a-zA-Z])*@[0-9a-zA-Z]([-_\.]?[0-9a-zA-Z])*\.[a-zA-Z]{2,3}$/i;
	
	if(!regExp.test(email)) {
		//this.gfn_alert(this, "이메일 형식이 잘못되었습니다. ex)manager@hanatour.com", "", "I", function()
		this.gfn_alert(this, "IUIAIR100759", ["", ""], "I", function()
			  {
				this.ds_BdngInfo.setColumn(index, "email", "");
				this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
				this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "email"), index);
				this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
			  }, "IUIAIR100759"
		);
		return false;
	}
	return true;
};

/***************************************************************************
 * 함  수  명   : fn_popupCallback
 * 기      능   : 팝업 콜백
 * 인      자   : objId	 			- Button
 *                objDst 				- ClickEventInfo
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_popupCallback = function(objId, objDst)
{
	switch (objId) 
	{
		case "AIRA0SLE1160P100" : //국제관광비행 예약 사전 안내
		
			var ds_flighPopTempDs = new Dataset;
			ds_flighPopTempDs.set_name("ds_flighPopTempDs");
			this.addChild("ds_flighPopTempDs", ds_flighPopTempDs);
			
			this.ds_flighPopTempDs.loadXML(objDst);
			
			var confirmYN = this.ds_flighPopTempDs.getColumn(0, "confirmYN");
			
			// Remove Object form Parent Form
			this.removeChild("ds_flighPopTempDs");
			if(confirmYN == "Y"){
				//예약하기 체크
				if(this.fn_chkFinishPaxInfo() == false) {
					return false;
				}	
			}				
		
			break;
		case "AIRA0SLE1160P090" : // 유아/아동 나이 구분 변경 안내
			//Create Object(필터할 비행편목록 임시 ds)
			var ds_tempDs = new Dataset;
			ds_tempDs.set_name("ds_tempDs");
			this.addChild("ds_tempDs", ds_tempDs);
			
			this.ds_tempDs.loadXML(objDst);
			
			var totCnt = this.ds_tempDs.getColumn(0, "totCnt");
			var adtAge = this.ds_tempDs.getColumn(0, "adtAge");
			
			// Remove Object form Parent Form
			this.removeChild("ds_tempDs");
			
			//탑승객 영문이름 중복 체크
			for(var i = 0; i < parseInt(totCnt); i++) {
				var paxName = this.ds_BdngInfo.getColumn(i, "paxLastName") + this.ds_BdngInfo.getColumn(i, "paxFirstName");
				for(var j = i+1; j < parseInt(totCnt); j++) {
					var comparisonName = this.ds_BdngInfo.getColumn(j, "paxLastName") + this.ds_BdngInfo.getColumn(j, "paxFirstName");
					if(paxName == comparisonName){
						//this.gfn_alert(this, "탑승객의 영문 이름을 확인해주세요. 하나의 예약에 동일한 이름으로 두 명 이상 예약되지 않습니다.");
						this.gfn_alert(this, "IUIAIR100750", ["", ""], "I", "", "IUIAIR100750");
						return false;
					}
				}
			}
			
			if(adtAge == "true") {
				//this.gfn_alert(this, "성인(만 18세 이상) 동반 없이 여행하는 만 12~17세 이하 청소년의 경우 운송항공사의 운영 정책에 따라 탑승이 제한 또는 거절 될 수 있습니다. 항공권 구매 전 해당 항공사로 필히 확인 부탁 드립니다.", "", "I", function()
				this.gfn_alert(this, "IUIAIR100751", ["", ""], "I", function()
					  {
						//예약생성하기
						this.fn_resCreation();
					  }, "IUIAIR100751"
				);
			}else{
				//예약생성하기
				this.fn_resCreation();
			}
			
			break;
			
		case "gatePage" : // 게이트페이지 팝업
			if(!this.gfn_isNull(objDst) && objDst != "anthAirRes" && objDst != "pdvClose"){
				//Create Object(예약상세 화면으로 넘겨줄 임시 ds)
				var ds_gatePage = new Dataset;
				ds_gatePage.set_name("ds_gatePage");
				this.addChild("ds_gatePage", ds_gatePage);
				this.ds_gatePage.loadXML(objDst);
				
				//예약상세 화면 호출
				var objForm = this;
				//var sMenuId = this.fv_objApp.gds_menu.getColumn(this.fv_objApp.gds_menu.findRow("menuUrl", "Biz_AIR_A0SLE::AIRA0SLE1190M010.xfdl"), "menuId"); // 실제호출할 메뉴의 objId(자원ID)-항공예약상세
				var sMenuId = "PPT0000020030";	// 항공예약상세 오브젝트ID
				var resId = this.ds_gatePage.getColumn(0, "resId");
				var resCd = this.ds_gatePage.getColumn(0, "resCd");
				var resComCd = this.ds_gatePage.getColumn(0, "resComCd");
				var airResProdDvCd = this.ds_gatePage.getColumn(0, "airResProdDvCd");
				var bkrNum = this.ds_gatePage.getColumn(0, "bkrNum");
				var saleAgtPtnCd = this.ds_gatePage.getColumn(0, "saleAgtPtnCd");
				var resPccCd = this.ds_gatePage.getColumn(0, "resPccCd");
				var isueRstatCd = this.ds_gatePage.getColumn(0, "isueRstatCd"); // 발권대표상태코드
				
				// Remove Object form Parent Form(예약상세 화면으로 넘겨줄 임시 ds)
				this.removeChild("ds_gatePage");
				
				var param = {
					"resId" : resId,
					"resCd" :  resCd,
					"resComCd" : resComCd,
					"airResProdDvCd" : airResProdDvCd,
					"bkrNum" : bkrNum,
					"saleAgtPtnCd" : saleAgtPtnCd,
					"resPccCd" : resPccCd,
					"isueRstatCd" : isueRstatCd
				}
				var sReloadFunc = "fn_farSearchReload";	// 초기화 처리를 위해 호출되는 함수, default : fn_reLoadCall
				
				this.gfn_mdiMenuCallReload(objForm, sMenuId, param, sReloadFunc);
			}
			
			break;
			
		default:
			break;
	}
};

/***************************************************************************
 * 함  수  명   : fn_searchInit
 * 기      능   : 화면초기화(게이트페이지에서 호출)
 ***************************************************************************/
this.fn_searchInit = function()
{
	//화면 초기화
	this.getOwnerFrame().form.div_work.form.div_srch_btn_reset_onclick();
};

/***************************************************************************
 * 함  수  명   : fn_adjustPayTypeGap
 * 기      능   : 결제방식 영역(divPayType)이 예약정보(div00) 아래로 내려온 높이만큼
 *                승객정보입력 타이틀 영역을 아래로 내려 겹치지 않게 조정
 *                (일반예약/법인예약 전환 시 div00 높이가 바뀌므로 매번 호출)
 * 인      자   : 없음
 * 리  턴  값   : 이전 대비 변경된 높이(px) - 상위 Div 높이 보정에 더해서 사용
 ***************************************************************************/
this.fn_adjustPayTypeGap = function()
{
	var objPaxForm = this.divPaxInfo.form;
	var nDiv00Bottom = objPaxForm.div00.getOffsetTop() + objPaxForm.div00.getOffsetHeight();
	var nPayTypeBottom = objPaxForm.divPayType.getOffsetTop() + objPaxForm.divPayType.getOffsetHeight();
	var nNewGap = 0;
	var nGapDiff = 0;
	var arrComp = null;
	var i = 0;

	//결제방식 영역이 더 아래로 내려온 경우에만 차이만큼 확보
	if(nPayTypeBottom > nDiv00Bottom){
		nNewGap = nPayTypeBottom - nDiv00Bottom;
	}

	nGapDiff = nNewGap - this.fv_payTypeGap;
	if(nGapDiff == 0){
		return 0;
	}

	//div00 기준으로 배치된 승객정보입력 타이틀 줄 컴포넌트 [컴포넌트, 레이아웃상 기본 top 오프셋]
	//stc01 이하(div01, div03, div02, div_btn)는 stc01 기준 상대배치라 함께 내려감
	arrComp = [
		[objPaxForm.stc01,   0],	//승객정보입력 타이틀
		[objPaxForm.stc02,   0],	//영문명 검증 메세지
		[objPaxForm.chk00,   11],	//여권정보 나중에 입력(전체)
		[objPaxForm.wbs_ocr, 5]		//OCR
	];
	for(i = 0; i < arrComp.length; i++){
		arrComp[i][0].set_top("div00:" + (arrComp[i][1] + nNewGap));
	}

	this.fv_payTypeGap = nNewGap;
	return nGapDiff;
};

//**************************************************************************
// [ PART 5 ] 컴포넌트 함수 정의
//**************************************************************************
/***************************************************************************
 * 함  수  명   : divPaxInfo_div00_rdoResDv_onitemchanged
 * 기      능   : 예약구분 변경 이벤트
 **************************************************************************/
this.divPaxInfo_div00_rdoResDv_onitemchanged = function(obj:nexacro.Radio,e:nexacro.ItemChangeEventInfo)
{
	var chkResInfo = this.divPaxInfo.form.div00.form.rdoResDv.value;//예약구분
	var nPayTypeGapDiff = 0;//결제방식 영역 높이 보정값
	if(chkResInfo == "BASIC") {
		//예약구분상세 영역 추가
		this.divPaxInfo.form.div02.setOffsetHeight(27);
		var rdoSiteVal = this.divPaxInfo.form.div00.form.rdoSite.value;//웹사이트지정
						
		/*
			일반예약 > 웹사이트 지정 시 Input_DV 값 설정 및 셀렉트박스 보여지도록 설정	
			MGR  : T03 (하나허브)
			ALL  : T06 (홈페이지)
			STD3 : D03 (닷컴)
			STD1 : D01 (콜센터)
		*/
		if(rdoSiteVal == "MGR"){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(false);//하나허브 선택시 콤보 비노출
			this.divPaxInfo.form.div00.form.cboSiteMgr.setInnerDataset(this.ds_selComListMgr);
			if(this.fv_cboMgrIdx != 0){
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboMgrIdx);
			}else{
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
			}
		}else if(rdoSiteVal == "ALL"){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);
			this.divPaxInfo.form.div00.form.cboSiteMgr.setInnerDataset(this.ds_selComListHomePage);
			if(this.fv_cboHomePageIdx != 0){
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboHomePageIdx);
			}else{
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
			}
		}else if(rdoSiteVal == "STD3"){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);
			this.divPaxInfo.form.div00.form.cboSiteMgr.setInnerDataset(this.ds_selComListDotCom);
			if(this.fv_cboDotComIdx != 0){
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboDotComIdx);
			}else{
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
			}
		}else if(rdoSiteVal == "STD1"){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);
			this.divPaxInfo.form.div00.form.cboSiteMgr.setInnerDataset(this.ds_selComListCallCenter);
			if(this.fv_cboCallCenterIdx != 0){
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboCallCenterIdx);
			}else{
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
			}
		}
		
		this.divPaxInfo.form.div00.form.stcWebSiteSelect.set_visible(true);
		this.divPaxInfo.form.div00.form.stc02.set_visible(true);
		this.divPaxInfo.form.div00.form.rdoSite.set_visible(true);
		//this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);//최초진입시 하나허브 선택으로 콤보 비노출
		var webSiteSelect = this.divPaxInfo.form.div00.getOffsetHeight();
		this.divPaxInfo.form.div00.setOffsetHeight(webSiteSelect + 52);
		this.divPaxInfo.setOffsetHeight(this.divPaxInfo.getOffsetHeight() + 52);
		nPayTypeGapDiff = this.fn_adjustPayTypeGap();//결제방식 영역이 div00 아래로 내려온 높이 변화량
		
		this.divPaxInfo.form.div00.form.cboSiteCats.set_visible(false);
		this.divPaxInfo.form.div02.form.stcBizPurpose.set_visible(false);
		this.divPaxInfo.form.div02.form.rdoBizPurpose.set_visible(false);
		var bizPurpose = this.divPaxInfo.form.div02.getOffsetHeight();
		this.divPaxInfo.form.div02.setOffsetHeight(bizPurpose);
		//승객예약Div 높이 조정
		this.divPaxInfo.setOffsetHeight(this.divPaxInfo.getOffsetHeight()+27+nPayTypeGapDiff);
		//최종선택여정 승객예약 Div 높이 조정
		var divBdngInfoHeight = this.parent.getOffsetHeight();
		this.parent.setOffsetHeight(divBdngInfoHeight+27+nPayTypeGapDiff);
		//최종선택여정 Div 높이 조정
		var divLastItnrHeight = this.parent.parent.parent.getOffsetHeight();
		this.parent.parent.parent.setOffsetHeight(divLastItnrHeight+27+nPayTypeGapDiff);
		//운임조회 최종선택여정 Div 높이 조정
		var divLastChcItnrHeight = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.divLastChcItnr.getOffsetHeight();
		this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.divLastChcItnr.setOffsetHeight(divLastChcItnrHeight+27+nPayTypeGapDiff);
		//운임조회 검색결과(우측) Div 높이 조정
		var div01Height = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.getOffsetHeight();
		this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.setOffsetHeight(div01Height+27+nPayTypeGapDiff);
		
	} else if(chkResInfo == "ST06"){
		/*
			법인 예약 시 Input_DV 값 T11로 설정
		*/
		//예약구분상세 영역 활성화
		this.divPaxInfo.form.div02.setOffsetHeight(53);
	
		this.divPaxInfo.form.div00.form.stcWebSiteSelect.set_visible(false);
		this.divPaxInfo.form.div00.form.stc02.set_visible(false);
		this.divPaxInfo.form.div00.form.rdoSite.set_visible(false);
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(false);
		var webSiteSelect = this.divPaxInfo.form.div00.getOffsetHeight();
		this.divPaxInfo.form.div00.setOffsetHeight(webSiteSelect - 52);//웹사이트 지정 영역 비활성화
		nPayTypeGapDiff = this.fn_adjustPayTypeGap();//결제방식 영역이 div00 아래로 내려온 높이 변화량
		
		this.divPaxInfo.form.div00.form.cboSiteCats.set_visible(true);
		this.divPaxInfo.form.div02.form.stcBizPurpose.set_visible(true);
		this.divPaxInfo.form.div02.form.rdoBizPurpose.set_visible(true);
		var bizPurpose = this.divPaxInfo.form.div02.getOffsetHeight();
		this.divPaxInfo.form.div02.setOffsetHeight(bizPurpose);
		
		//법인회원사검색 ds 초기화
		this.ds_schCrpnInfo.clearData();
		//법인회원사검색으로 ds가 바뀐 경우 초기 ds 재설정
		this.divPaxInfo.form.div00.form.cboSiteCats.set_innerdataset(this.ds_selComListCats);//법인예약 콤보박스 설정
		//선택하세요 및 법인회원사검색인지 판단
		if(this.fv_cboSiteCatsIdx != 0 && this.fv_cboSiteCatsIdx != (this.ds_selComListCats.getRowCount()-1)){
			this.divPaxInfo.form.div00.form.cboSiteCats.set_index(this.fv_cboSiteCatsIdx);
		}else{
			this.divPaxInfo.form.div00.form.cboSiteCats.set_index(0);
		}
		//승객예약Div 높이 조정
		this.divPaxInfo.setOffsetHeight(this.divPaxInfo.getOffsetHeight()-26+nPayTypeGapDiff);
		//최종선택여정 승객예약 Div 높이 조정
		var divBdngInfoHeight = this.parent.getOffsetHeight();
		this.parent.setOffsetHeight(divBdngInfoHeight-26+nPayTypeGapDiff);
		//최종선택여정 Div 높이 조정
		var divLastItnrHeight = this.parent.parent.parent.getOffsetHeight();
		this.parent.parent.parent.setOffsetHeight(divLastItnrHeight-26+nPayTypeGapDiff);
		//운임조회 최종선택여정 Div 높이 조정
		var divLastChcItnrHeight = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.divLastChcItnr.getOffsetHeight();
		this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.divLastChcItnr.setOffsetHeight(divLastChcItnrHeight-26+nPayTypeGapDiff);
		//운임조회 검색결과(우측) Div 높이 조정
		var div01Height = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.getOffsetHeight();
		this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.setOffsetHeight(div01Height-26+nPayTypeGapDiff);
	}
	this.getOwnerFrame().form.div_work.form.div_cntnt.form.resetScroll();
};

/***************************************************************************
 * 함  수  명   : divPaxInfo_div_btn_btnReserve_onclick
 * 기      능   : 예약하기 버튼 클릭 이벤트
 **************************************************************************/
this.divPaxInfo_div_btn_btnReserve_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	//선회비행 사전안내 팝업	
	var pFareId = this.ds_farDtlSrchIn.getColumn(0, "fareId");
	this.ds_itnrListTemp01.filter("fareId == '"+ pFareId +"'");
	var gnrlEvent1Cd = this.ds_itnrListTemp01.getColumn(0, "gnrlEvent1Cd");
	var gnrlEvent2Cd = this.ds_itnrListTemp01.getColumn(0, "gnrlEvent2Cd");
	
	if(gnrlEvent1Cd == "GRIB00016" || gnrlEvent2Cd == "GRIB00016" ){
		this.fn_intTourFlightPopUp();
	}else{
		if(this.fn_chkFinishPaxInfo() == false) {
			return false;
		}
	}
};

