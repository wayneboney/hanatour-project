		this.divPaxInfo.form.div_btn.form.stc02.set_color("black");
		this.divPaxInfo.form.div_btn.form.stc02.set_text("※ 탑승객의 승객정보 의무 수집 강화로 인해 비상연락처를 필수로 입력해야 합니다");
	}
	
	if(arrChkFlag){
