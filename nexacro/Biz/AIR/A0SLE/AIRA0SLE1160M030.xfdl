/***************************************************************************
 * 함  수  명   : divPaxInfo_div02_btnFareRule_onclick
 * 기      능   : 요금규정 보기 버튼 클릭 이벤트
 **************************************************************************/
this.divPaxInfo_div02_btnFareRule_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.ds_detailView.clearData();
	this.ds_detailView.addRow();
	this.ds_detailView.setColumn(0, "fareId", this.parent.parent.parent.parent.ds_resCret.getColumn(0, "fareId"));
	this.ds_detailView.setColumn(0, "apiSupCode", this.parent.parent.parent.parent.ds_resCret.getColumn(0, "apiSupCode"));
	this.ds_detailView.setColumn(0, "cardPromEventCd", this.parent.parent.parent.parent.ds_resCret.getColumn(0, "eventCd"));
	
	var objForm			= this;
	var sPopupId		= "detailView";
	var sUrl			= "Biz_AIR_A0SLE::AIRA0SLE1160P070.xfdl";
	var objArgument		= {srchType:"farSrch",dsDetailView:this.ds_detailView,tabView:3};
	var sPopupCallback	= "";
	var objOption		    = {};
		objOption.left 		= -1;			    // 좌측 좌표 (-1 : 자동정렬)
		objOption.top 		= -1;			    // 상단 좌표 (-1 : 자동정렬)
		objOption.width 	= 1000;   			// 넓이 (-1 : AutoSize - true)
		objOption.height 	= 930;			    // 높이 (-1 : AutoSize - true)
		objOption.popuptype = "modal";		    // 팝업종류(modal:showModal, modeless:nexacro.open)
		objOption.layered 	= false;
		objOption.opacity 	= 1;
		objOption.autosize 	= true;
		objOption.resizable = true;
		objOption.titlebar 	= false;
		objOption.title 	= "";
		objOption.titleStaticId = "stc_titlebar";	// 팝업에서 title 역할을 하는 static의 id , 반드시 보내야 함
		
	this.gfn_openPopup(objForm, sPopupId, sUrl, objArgument, sPopupCallback, objOption);
};

/***************************************************************************
 * 함  수  명   : divPaxInfo_div00_cboSiteCats_oninnerdatachanged
 * 기      능   : 법인예약 콤보 박스 변경 이벤트
 **************************************************************************/
this.divPaxInfo_div00_cboSiteCats_onitemchanged = function(obj:nexacro.Combo,e:nexacro.ItemChangeEventInfo)
{
	var val = obj.value;
	var airDiscount = 0;
	var corp_code = "";
	
	if(val != "00") {
		if(val == "99") {
			//법인회원사 조회 팝업
			this.fn_crpnOpenPopup();
		}
	}
	
	this.fv_cboSiteCatsIdx = obj.index; //법인예약 콤보박스 선택 idx
};

/***************************************************************************
 * 함  수  명   : divPaxInfo_div00_cboSiteMgr_onitemchanged
 * 기      능   : 웹사이트지정 콤보박스 변경 이벤트
 **************************************************************************/
this.divPaxInfo_div00_cboSiteMgr_onitemchanged = function(obj:nexacro.Combo,e:nexacro.ItemChangeEventInfo)
{
	var rdoSiteVal = this.divPaxInfo.form.div00.form.rdoSite.value;//웹사이트지정
	if(rdoSiteVal == "MGR"){
		this.fv_cboMgrIdx = obj.index; //웹사이트지정 하나허브 콤보박스 선택 idx
	}else if(rdoSiteVal == "ALL"){
		this.fv_cboHomePageIdx = obj.index; //웹사이트지정 홈페이지 콤보박스 선택 idx
	}else if(rdoSiteVal == "STD3"){
		this.fv_cboDotComIdx = obj.index; //웹사이트지정 닷컴 콤보박스 선택 idx
	}else if(rdoSiteVal == "STD1"){
		this.fv_cboCallCenterIdx = obj.index; //웹사이트지정 콜센터 콤보박스 선택 idx
	}
};

