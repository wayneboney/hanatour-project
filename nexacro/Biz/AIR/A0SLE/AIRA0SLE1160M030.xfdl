                    <Button id="btnFareRule" taborder="4" text="보기" top="1" width="34" height="23" fittocontents="width" onclick="divPaxInfo_div02_btnFareRule_onclick" left="stc01:-50"/>
                    <Radio id="rdoAirRuleAgreeY" taborder="1" top="0" width="236" height="23" innerdataset="innerdataset" codecolumn="codecolumn" datacolumn="datacolumn" direction="vertical" text="일반예약" left="stc01:3" onitemchanged="divPaxInfo_div02_rdoAirRuleAgreeY_onitemchanged">
