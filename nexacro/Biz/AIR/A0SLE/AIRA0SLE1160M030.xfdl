							this.gfn_alert(this, "IUIAIR100748", ["", ""], "I", function()
								  {
									this.divPaxInfo.form.div01.form.grdBdngInfo.setFocus();
									this.divPaxInfo.form.div01.form.grdBdngInfo.setCellPos(this.divPaxInfo.form.div01.form.grdBdngInfo.getBindCellIndex("body", "birthDay"), i);
									this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
								  }, "IUIAIR100748"
							);
							return false;
						}
					}
					
					if(!this.gfn_isNull(arrDate)){
						//귀국일 기준 아동 나이 구분 변경 안내 체크
						if( !(parseInt(arrAge) >= 2 && parseInt(arrAge) < 12)) {
							arrChkFlag = true;//귀국편 유아/아동 나이 구분 변경 안내 체크
						}
