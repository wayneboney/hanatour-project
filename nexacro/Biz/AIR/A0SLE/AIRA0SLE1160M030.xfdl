/***************************************************************************
 * 함  수  명   : fn_callBack
 * 기      능   : Transaction 후 처리
 * 인      자   : sSvcId 			- Transaction 고유ID
 *                 nErrorCode 		- 에러코드
 *                 sErrorMsg 		- 에러메세지
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_callBack = function(sSvcId, nErrorCode, sErrorMsg)
{
    // 에러시 처리
	if(nErrorCode != 0)
	{
		// 메시지 관련 처리
		sMessage = "[sSvcId]:"+sSvcId+"\n[nErrorCode]:"+nErrorCode+"\n[sErrorMsg]:"+sErrorMsg;
		this.gfn_alert(this, sMessage, "", "E", "fn_msgCallback", "tranError");
		return;
	}

	// 정상일때 서비스ID별 처리
	// 체크에 대한 모든 메세지 alert 은 전체 체크 후 통합 메세지 한번으로 처리한다.
	switch (sSvcId) 
	{
		//권한적용 <항공 공통에서 처리되는 케이스>
		//////////////////////////////////////////////////////////////
	    case "_getFormAuthObjList" :
		     this.bfn_setAuth(this._ds_authObjList, this, "this");	
			break;	
		//////////////////////////////////////////////////////////////
		case "cboSiteList" ://사이트코드 조회
			//법인예약 Ds 설정
			this.ds_selComListCats.clearData();
			this.ds_selComListCats.addRow();
			this.ds_selComListCats.setColumn(0, "codeVal", "00");
			this.ds_selComListCats.setColumn(0, "codeNm", "선택하세요");
			
			//하나허브 Ds 설정
			this.ds_selComListMgr.clearData();
			this.ds_selComListMgr.addRow();
			this.ds_selComListMgr.setColumn(0, "codeVal", "00");
			this.ds_selComListMgr.setColumn(0, "codeNm", "선택하세요");
			
			//홈페이지 Ds 설정
			this.ds_selComListHomePage.clearData();
			this.ds_selComListHomePage.addRow();
			this.ds_selComListHomePage.setColumn(0, "codeVal", "00");
			this.ds_selComListHomePage.setColumn(0, "codeNm", "선택하세요");
			
			//닷컴 Ds 설정
			this.ds_selComListDotCom.clearData();
			this.ds_selComListDotCom.addRow();
			this.ds_selComListDotCom.setColumn(0, "codeVal", "00");
			this.ds_selComListDotCom.setColumn(0, "codeNm", "선택하세요");
			
			//콜센터 Ds 설정
			this.ds_selComListCallCenter.clearData();
			this.ds_selComListCallCenter.addRow();
			this.ds_selComListCallCenter.setColumn(0, "codeVal", "00");
			this.ds_selComListCallCenter.setColumn(0, "codeNm", "선택하세요");
			
		
		
			
			if(this.ds_siteList.getRowCount() == 0){ //회원사사이트코드 없는 대리점인 경우 ds_siteList 수동 세팅

				this.ds_siteList.addRow();
				this.ds_siteList.setColumn(0, "memcSiteCd", 'null');
				this.ds_siteList.setColumn(0, "ptnCd", this.fv_objApp.gds_userInfo.getColumn(0, "unfyPtnCd"));
				this.ds_siteList.setColumn(0, "memcSiteTypeCd", 'null');
				this.ds_siteList.setColumn(0, "siteNm", 'null');
				this.ds_siteList.setColumn(0, "ptnKoNm", this.fv_objApp.gds_userInfo.getColumn(0, "unfyPtnNm"));
			}
			if(this.ds_siteList.getRowCount() > 0){
		
				
				//법인예약
				this.ds_tempSiteList.clearData();
				this.ds_tempSiteList.copyData(this.ds_siteList, true);//법인예약 임시보관
				this.ds_tempSiteList.set_filterstr("memcSiteTypeCd == 'ST06'");//필터링
				
				for(var i = 0; i < this.ds_tempSiteList.getRowCount(); i++){
					this.ds_selComListCats.addRow();
					var codeVal = this.ds_tempSiteList.getColumn(i, "memcSiteCd");
					var codeNm = this.ds_tempSiteList.getColumn(i, "siteNm") + "[" + this.ds_tempSiteList.getColumn(i, "memcSiteCd") + "]";
					var ptnCd = this.ds_tempSiteList.getColumn(i, "ptnCd");
					this.ds_selComListCats.setColumn(i+1, "codeVal", codeVal);
					this.ds_selComListCats.setColumn(i+1, "codeNm", codeNm);
					this.ds_selComListCats.setColumn(i+1, "ptnCd", ptnCd);
				}
				this.ds_selComListCats.addRow();
				this.ds_selComListCats.setColumn(this.ds_tempSiteList.getRowCount()+1, "codeVal", "99");
				this.ds_selComListCats.setColumn(this.ds_tempSiteList.getRowCount()+1, "codeNm", "법인회원사 검색");
				
				this.divPaxInfo.form.div00.form.cboSiteCats.set_innerdataset(this.ds_selComListCats);//법인예약 콤보박스 설정
				
				this.ds_siteList.set_filterstr("memcSiteTypeCd != 'STD3' && memcSiteTypeCd != 'STD1'");//필터링할 조건식을 설정
				
				if(this.ds_siteList.getRowCount() > 0){
					//하나허브
					this.ds_selComListMgr.addRow();
					var codeVal = this.ds_siteList.getColumn(0, "memcSiteCd");
					var codeNm = this.ds_siteList.getColumn(0, "siteNm") + "[" + this.ds_siteList.getColumn(0, "memcSiteCd") + "]";
					var ptnCd = this.ds_siteList.getColumn(i, "ptnCd");
					this.ds_selComListMgr.setColumn(1, "codeVal", codeVal);
					this.ds_selComListMgr.setColumn(1, "codeNm", codeNm);
					this.ds_selComListMgr.setColumn(1, "ptnCd", ptnCd);
					
				
				}
				
				//홈페이지
				for(var i = 0; i < this.ds_siteList.getRowCount(); i++){
					if(this.ds_siteList.getColumn(i, "memcSiteCd") != 'null'){ //회원사사이트코드 없는 대리점인 경우 홈페이지 추가하지 않음
						this.ds_selComListHomePage.addRow();
						var codeVal = this.ds_siteList.getColumn(i, "memcSiteCd");
						var codeNm = this.ds_siteList.getColumn(i, "siteNm") + "[" + this.ds_siteList.getColumn(i, "memcSiteCd") + "]";
						var ptnCd = this.ds_siteList.getColumn(i, "ptnCd");
						this.ds_selComListHomePage.setColumn(i+1, "codeVal", codeVal);
						this.ds_selComListHomePage.setColumn(i+1, "codeNm", codeNm);
						this.ds_selComListHomePage.setColumn(i+1, "ptnCd", ptnCd);
					}
				}
				this.ds_siteList.set_filterstr("");
				
				//닷컴
				this.ds_tempSiteList.clearData();
				this.ds_tempSiteList.copyData(this.ds_siteList, true);//닷컴 임시보관
				this.ds_tempSiteList.set_filterstr("memcSiteTypeCd == 'STD3'");//필터링
				for(var i = 0; i < this.ds_tempSiteList.getRowCount(); i++){
					this.ds_selComListDotCom.addRow();
					var codeVal = this.ds_tempSiteList.getColumn(i, "memcSiteCd");
					var codeNm = this.ds_tempSiteList.getColumn(i, "siteNm") + "[" + this.ds_tempSiteList.getColumn(i, "memcSiteCd") + "]";
					var ptnCd = this.ds_tempSiteList.getColumn(i, "ptnCd");
					this.ds_selComListDotCom.setColumn(i+1, "codeVal", codeVal);
					this.ds_selComListDotCom.setColumn(i+1, "codeNm", codeNm);
					this.ds_selComListDotCom.setColumn(i+1, "ptnCd", ptnCd);
				}
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_innerdataset(this.ds_selComListMgr);
				this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
				this.fv_cboMgrIdx = 0; //웹사이트지정 하나허브 콤보박스 선택 idx
				//닷컴 데이터 존재 여부로 웹사이트 콤보 설정
				var callCenterYn = 'N';
				//사이트코드 조회시 계약관계코드가 192인 거래처는 memcSiteTypeCd가 STD1
				for(var i = 0; i < this.ds_siteList.getRowCount(); i++){
					if(this.ds_siteList.getColumn(i, "memcSiteTypeCd") == "STD1"){
						callCenterYn = 'Y';
					}
				}
								
				this.ds_rdoWebSite.clearData();
				if(this.ds_selComListDotCom.getRowCount() == 1){
					this.ds_rdoWebSite.addRow();
					this.ds_rdoWebSite.setColumn(0, "codecolumn", "MGR");
					this.ds_rdoWebSite.setColumn(0, "datacolumn", "하나허브");
					if(this.ds_siteList.getColumn(0, "memcSiteCd") != 'null'){ //회원사사이트코드 없는 대리점인 경우 홈페이지 라디오 제외
						this.ds_rdoWebSite.addRow();
						this.ds_rdoWebSite.setColumn(1, "codecolumn", "ALL");
						this.ds_rdoWebSite.setColumn(1, "datacolumn", "홈페이지");
					}
					if(callCenterYn == 'Y'){
						this.ds_rdoWebSite.addRow();
						this.ds_rdoWebSite.setColumn(2, "codecolumn", "STD1");
						this.ds_rdoWebSite.setColumn(2, "datacolumn", "콜센터");
						this.divPaxInfo.form.div00.form.rdoSite.set_width(356);
					}
				}else{
					this.ds_rdoWebSite.addRow();
					this.ds_rdoWebSite.setColumn(0, "codecolumn", "MGR");
					this.ds_rdoWebSite.setColumn(0, "datacolumn", "하나허브");
					this.ds_rdoWebSite.addRow();
					this.ds_rdoWebSite.setColumn(1, "codecolumn", "ALL");
					this.ds_rdoWebSite.setColumn(1, "datacolumn", "홈페이지");
					this.ds_rdoWebSite.addRow();
					this.ds_rdoWebSite.setColumn(2, "codecolumn", "STD3");
					this.ds_rdoWebSite.setColumn(2, "datacolumn", "닷컴");
					if(callCenterYn == 'Y'){
						this.ds_rdoWebSite.addRow();
						this.ds_rdoWebSite.setColumn(3, "codecolumn", "STD1");
						this.ds_rdoWebSite.setColumn(3, "datacolumn", "콜센터");
						this.divPaxInfo.form.div00.form.rdoSite.set_width(356);
					}
				}
				
				this.divPaxInfo.form.div00.form.rdoSite.set_innerdataset(this.ds_rdoWebSite);//웹사이트지정 라디오버튼 설정
				this.divPaxInfo.form.div00.form.rdoSite.set_value("MGR");
				
				//항공 콜센터 라디오버튼 비활성화(PDEV-4559)
				for (var i = 0; i < this.ds_rdoWebSite.rowcount; i++){
					if("STD1" == this.ds_rdoWebSite.getColumnNF(i,"codecolumn")){ //콜센터
						this.divPaxInfo.form.div00.form.rdoSite._items[i].set_enable(false);
					}
				}
				
				//콜센터
				this.ds_tempSiteList.clearData();
				this.ds_tempSiteList.copyData(this.ds_siteList, true);//콜센터 임시보관
				this.ds_tempSiteList.set_filterstr("memcSiteTypeCd == 'STD1'");//필터링
				for(var i = 0; i < this.ds_tempSiteList.getRowCount(); i++){
					this.ds_selComListCallCenter.addRow();
					var codeVal = this.ds_tempSiteList.getColumn(i, "memcSiteCd");
					var codeNm = this.ds_tempSiteList.getColumn(i, "siteNm") + "[" + this.ds_tempSiteList.getColumn(i, "memcSiteCd") + "]";
					var ptnCd = this.ds_tempSiteList.getColumn(i, "ptnCd");
					this.ds_selComListCallCenter.setColumn(i+1, "codeVal", codeVal);
					this.ds_selComListCallCenter.setColumn(i+1, "codeNm", codeNm);
					this.ds_selComListCallCenter.setColumn(i+1, "ptnCd", ptnCd);
				}
			}
			break;
			
		case "farRulesScRulList" ://운임규정 서비스규정목록 조회
			trace(this.ds_headInfoOut.saveXML());
			if(this.ds_returnBizComOut.getColumn(0, "resultCode") != "0000"){
				//this.gfn_confirm(this, "현재 유효한 운임이 아닙니다. 재조회 하시겠습니까?", [], "", function (sId, sVal)
				this.gfn_confirm(this, "IUIAIR100727", ["", ""], "C", function (sId, sVal)
					{
						if(sVal) {
							//항공검색결과리스트 재조회
							this.getOwnerFrame().form.div_work.form.fn_search();
						}else{
							this.divPaxInfo.form.div_btn.form.btnReserve.set_enable(false);//예약하기 버튼 비활성화
						}
					});
			}
			break;
			
		case "getAgtTelSrch" ://대리점 전화번호 유무 체크
			if(this.ds_agtTelSrchOut.getRowCount() > 0){
				//운임유효성조회
				this.fn_fareAvailChk();
			}else{
				//this.gfn_alert(this, "대리점 전화번호가 없을 경우 항공예약 진행이 불가하오니 담당세일즈에게 문의하여 전화번호 등록후 진행해주시기 바랍니다.");
				this.gfn_alert(this, "IUIAIR100728", ["", ""], "I", "", "IUIAIR100728");
			}
			break;
			
		case "getFareAvailChk" ://운임유효성조회
			trace(this.ds_headInfoOut.saveXML());
			if(this.ds_returnBizComOut.getColumn(0, "resultCode") == "0000"){
				if(this.ds_fareAvailChkOut.getColumn(0, "fareAvailYn") == "Y"){
					//미주지역이면서 제외항공사일경우 && 여권번호,만료일 없을경우 (this.areaGubun <--이 부분 참고))
					for(var i=0;i<this.ds_BdngInfo.rowcount;i++){
						var ppn = this.ds_BdngInfo.getColumn(i, "tustPpn");
						var expyDt = this.ds_BdngInfo.getColumn(i, "tustPsptExpyDt");
						
						if (this.gfn_isNull(ppn) || this.gfn_isNull(expyDt)) {
							this.tustGubun = "Y";
							break;
						}
					}
					
					//미얀마 항공일시
					var objResult = this.getOwnerFrame().form.div_work.form.ds_srchFltLstOut;
					var mmCheck = objResult.findRowExpr("depCntryCd == 'MM' || arrCntryCd == 'MM'");		
					var mmMsg = "[미얀마 국적 탑승객 신분증(National ID)정보 제출 의무화 안내]\n\n"
							  + "미얀마 공항 당국의 지침에 따라 2026년 4월 9일부터 미얀마 국적 탑승객의 National ID(NRC) 정보 제출 및 원본 지참이 의무화되었습니다.\n"
							  + "미얀마 국적 탑승객은 예약 후 [기타요청] 메뉴를 통해 National ID(NRC)정보를 입력해 주시고, 공항 방문 시에는 반드시 신분증 원본을 지참해 주시기 바랍니다.";
					
					if(this.areaGubun=="Y" && this.tustGubun=="Y"){
						var msg = "●여권번호/여권만료일을 입력을 하지 않으면 자동발권대상에서 제외가 됩니다.\n●ZH, ZA, Z8, SU, SC, RG, MU, MF, KC, HY, HU, GS, FM, CZ, CA, AR, 3U 예약 시 입력하신 모든 정보는 수정이 불가능하오니 정확한 정보로 입력해 주시기 바랍니다.\n위 내용을 확인하셨습니까?";
						this.gfn_confirm(this, msg, ["", ""], "", function (sId, sVal){
							if(sVal){
								if (mmCheck !== -1) {
									this.gfn_alert(this, mmMsg ,"" ,"",function(){
										//예약하기 진행
										this.fn_resCeationProc();
									}, "");
								} else {
									//예약하기 진행
									this.fn_resCeationProc();
								}
							}
						});
					}else{
						if (mmCheck !== -1) {
							this.gfn_alert(this, mmMsg ,"" ,"",function(){
								//예약하기 진행
								this.fn_resCeationProc();
							}, "");
						} else {
							//예약하기 진행
							this.fn_resCeationProc();
						}
					}
					
				}else{
					//this.gfn_confirm(this, "현재 유효한 운임이 아닙니다. 재조회 하시겠습니까?",[], "", function (sId, sVal)
					this.gfn_confirm(this, "IUIAIR100727", ["", ""], "I", function (sId, sVal)
						{
							if(sVal) {
								if(this.getOwnerFrame().form._fv_progId == "AIRA0SLE1160M000"){//항공검색결과리스트
									//항공검색결과리스트 재조회
									this.getOwnerFrame().form.div_work.form.fn_search();
								}
							}
						});
				}
			}else{
				//this.gfn_alert(this, "운임 조회에 실패하였습니다. 잠시 후에 다시 시도해주세요. ["+this.ds_returnBizComOut.getColumn(0, "resultMsg")+"]");
				this.gfn_alert(this, "IUIAIR100711", [this.ds_returnBizComOut.getColumn(0, "resultMsg"), ""], "E", "", "");
			}
			break;
			
		case "resCreation" ://예약생성
			trace(this.ds_headInfoOut.saveXML());
			if(this.ds_returnBizComOut.getColumn(0, "resultCode") == "0000"){
				//예약하기 버튼 비활성화
				this.divPaxInfo.form.div_btn.form.btnReserve.set_enable(false);
				
				//항공예약관리>게이트페이지 이동
				var objForm			= this;
				var sPopupId		= "gatePage";
				var sUrl			= "Biz_AIR_A0SLE::AIRA0SLE1190M020.xfdl";
				var objArgument		= {"resCreatInfo" : this.ds_resCreatInfoOut};
				var sPopupCallback	= "fn_popupCallback";
				var objOption		= {};
					objOption.left 		= -1;			    // 좌측 좌표 (-1 : 자동정렬)
					objOption.top 		= -1;			    // 상단 좌표 (-1 : 자동정렬)
					objOption.width 	= 1230;   			// 넓이 (-1 : AutoSize - true)
					objOption.height 	= 775;			    // 높이 (-1 : AutoSize - true)
					objOption.popuptype = "modal";		    // 팝업종류(modal:showModal, modeless:nexacro.open)
					objOption.layered 	= false;
					objOption.opacity 	= 1;
					objOption.autosize 	= true;
					objOption.resizable = true;
					objOption.titlebar 	= false;
					objOption.title 	= "";
					objOption.titleStaticId = "stc_titlebar";	// 팝업에서 title 역할을 하는 static의 id , 반드시 보내야 함
					
				this.gfn_openPopup(objForm, sPopupId, sUrl, objArgument, sPopupCallback, objOption);
			}else{
				//this.gfn_alert(this, "예약 실패되었습니다. 잠시 후에 다시 시도해주세요. ["+this.ds_returnBizComOut.getColumn(0, "resultMsg")+"]");
				this.gfn_alert(this, "IUIAIR100730", [this.ds_returnBizComOut.getColumn(0, "resultMsg"), ""], "E", "", "");
			}
			
			break;
		case "getTxinKndSrch" ://세금계산서 설정 조회
			this.fn_txinKndSetting();//세금계산서 라디오 구성
			
			break;
		//대리점 예약가능여부 값 전연변수 설정
	    case "getCheckRsvAvailInfo" :
			break;	
		
		//비상연락처 국가코드 디폴트 "KR"로 설정 - (한국(+82))
		case "TEL_EMRG_CNTRY_CD" :
			this.divPaxInfo.form.div_btn.form.div00.form.cbo_emrgMpCntryCd.set_value("KR");
			break;
			
		default:
			break;
	}
};

/***************************************************************************
 * 함  수  명   : fn_chkFinishPaxInfo
 * 기      능   : 예약하기 체크
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_chkFinishPaxInfo = function()
{
	//대리점 예약생성 가능여부 확인 
	if ( this.ds_ptnAvailInfo.getColumn(0, "resPsblYn") != "Y"  ){
		this.gfn_alert(this, "IUIAIR101062", [], "I", "", "");
		return false;
	}
	
	//1번 탑승객 이외 핸드폰, 이메일 정보가 입력 되어 있지 않으면 "" 설정
	this.ds_BdngInfo.removeEventHandler( "oncolumnchanged", this.ds_BdngInfo_oncolumnchanged, this );
	for(var j = 1; j < this.ds_BdngInfo.getRowCount(); j++){
		if(this.ds_BdngInfo.getColumn(j, "mobileNo") == "ex)01012341234"){
			this.ds_BdngInfo.setColumn(j, "mobileNo", "");
		}
		
		if(this.ds_BdngInfo.getColumn(j, "email") == "ex)manager@hanatour.com"){
			this.ds_BdngInfo.setColumn(j, "email", "");
		}
	}
	this.ds_BdngInfo.setEventHandler( "oncolumnchanged", this.ds_BdngInfo_oncolumnchanged, this );

	var AirRuleAgree = this.divPaxInfo.form.div02.form.rdoAirRuleAgreeY.value;
	var reservationRadio = this.divPaxInfo.form.div00.form.rdoResDv.value;
	
	if(AirRuleAgree == "N") {
		//this.gfn_alert(this, "항공약관 및 요금규정을 읽고 동의 하여 주십시오.");
		this.gfn_alert(this, "IUIAIR100731", ["", ""], "I", "", "IUIAIR100731");
		return false;
	}
	var fareType = this.getOwnerFrame().form.div_work.form.ds_lastChcItnrFarAmt.getColumn(0, "apiSupCode");//M:아마데우스, G:갈릴레오, B:세이버, I:에어아시아, V:하나투어 인벤토리(RT)
	var AdtCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "adtCnt");
	var ChdCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "chdCnt");
	var InfCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "infCnt");
	var totCnt = parseInt(AdtCnt)+parseInt(ChdCnt)+parseInt(InfCnt);
	
	//출국편(출국)/귀국편(출국)/여정1(출국)~6(출국)의 마케팅항공사코드(mktAlCode)
	var nIdx01 = -1;
	var nIdx02 = -1;
	var nIdx03 = -1;
	var nIdx04 = -1;
	var nIdx05 = -1;
	var nIdx06 = -1;
	//마케팅항공사코드
	var mktAlCode01 = "";
	var mktAlCode02 = "";
	var mktAlCode03 = "";
	var mktAlCode04 = "";
	var mktAlCode05 = "";
	var mktAlCode06 = "";
	
	if(this.getOwnerFrame().form.div_work.form.fv_searchId != "lstChncEvent"){//최종찬스이벤트가 아니면
		if(this.getOwnerFrame().form.div_work.form.ds_srchEtcInfoOut.getColumn(0, "itnrTypeCd") == "RT"){
			nIdx01 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div01.form.grd01.currentrow;
			mktAlCode01 = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(nIdx01, "mktAlCode");
			nIdx02 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div02.form.grd02.currentrow;
			mktAlCode02 = this.getOwnerFrame().form.div_work.form.ds_itnrList02.getColumn(nIdx02, "mktAlCode");
		}else if(this.getOwnerFrame().form.div_work.form.ds_srchEtcInfoOut.getColumn(0, "itnrTypeCd") == "OW"){
			nIdx01 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div01.form.grd01.currentrow;
			mktAlCode01 = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(nIdx01, "mktAlCode");
		}else if(this.getOwnerFrame().form.div_work.form.ds_srchEtcInfoOut.getColumn(0, "itnrTypeCd") == "MD"){
			nIdx01 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div01.form.grd01.currentrow;
			mktAlCode01 = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(nIdx01, "mktAlCode");
			nIdx02 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div02.form.grd02.currentrow;
			mktAlCode02 = this.getOwnerFrame().form.div_work.form.ds_itnrList02.getColumn(nIdx02, "mktAlCode");
			
			var itnrCnt = this.getOwnerFrame().form.div_work.form.ds_srchItnrLstOut.getRowCount();
			if(itnrCnt == 3){
				nIdx03 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div03.form.grd03.currentrow;
				mktAlCode03 = this.getOwnerFrame().form.div_work.form.ds_itnrList03.getColumn(nIdx03, "mktAlCode");
			}else if(itnrCnt == 4){
				nIdx03 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div03.form.grd03.currentrow;
				mktAlCode03 = this.getOwnerFrame().form.div_work.form.ds_itnrList03.getColumn(nIdx03, "mktAlCode");
				nIdx04 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div04.form.grd04.currentrow;
				mktAlCode04 = this.getOwnerFrame().form.div_work.form.ds_itnrList04.getColumn(nIdx04, "mktAlCode");
			}else if(itnrCnt == 5){
				nIdx03 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div03.form.grd03.currentrow;
				mktAlCode03 = this.getOwnerFrame().form.div_work.form.ds_itnrList03.getColumn(nIdx03, "mktAlCode");
				nIdx04 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div04.form.grd04.currentrow;
				mktAlCode04 = this.getOwnerFrame().form.div_work.form.ds_itnrList04.getColumn(nIdx04, "mktAlCode");
				nIdx05 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div05.form.grd05.currentrow;
				mktAlCode05 = this.getOwnerFrame().form.div_work.form.ds_itnrList05.getColumn(nIdx05, "mktAlCode");
			}else if(itnrCnt == 6){
				nIdx03 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div03.form.grd03.currentrow;
				mktAlCode03 = this.getOwnerFrame().form.div_work.form.ds_itnrList03.getColumn(nIdx03, "mktAlCode");
				nIdx04 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div04.form.grd04.currentrow;
				mktAlCode04 = this.getOwnerFrame().form.div_work.form.ds_itnrList04.getColumn(nIdx04, "mktAlCode");
				nIdx05 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div05.form.grd05.currentrow;
				mktAlCode05 = this.getOwnerFrame().form.div_work.form.ds_itnrList05.getColumn(nIdx05, "mktAlCode");
				nIdx06 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div06.form.grd06.currentrow;
				mktAlCode06 = this.getOwnerFrame().form.div_work.form.ds_itnrList06.getColumn(nIdx06, "mktAlCode");
			}
		}
	}else{//최종찬스이벤트
		nIdx01 = this.getOwnerFrame().form.div_work.form.div_cntnt.form.div01.form.div01.form.grd01.currentrow;
		mktAlCode01 = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(nIdx01, "mktAlCode");
		var fareId = this.getOwnerFrame().form.div_work.form.ds_itnrList01.getColumn(nIdx01, "fareId");
		var filterVal = "fareId == '" + fareId + "' && itnrSeq == '2'";
		this.getOwnerFrame().form.div_work.form.ds_srchFarLstOut.filter(filterVal);
		mktAlCode02 = this.getOwnerFrame().form.div_work.form.ds_srchFarLstOut.getColumn(0, "mktAlCode");
	}
	
	var clasCd = "";
	
	//MU항공사 체크
	var MuFlag = false;
	for(var j = 0; j < this.parent.parent.parent.parent.ds_lastItnrFlgt.getRowCount(); j++){
		var mktAlCode = this.parent.parent.parent.parent.ds_lastItnrFlgt.getColumn(j, "mktAlCode");
		var oprAlCode = this.parent.parent.parent.parent.ds_lastItnrFlgt.getColumn(j, "oprAlCode");
		var clasCd = this.parent.parent.parent.parent.ds_lastItnrFlgt.getColumn(j, "bookClass");
		
		trace(j + "번째 bookClass 정보 :::: " + clasCd);
		if(mktAlCode == "MU" || oprAlCode == "MU"){
			MuFlag = true;
		}
	}
	
	var dt = new Date();
	
	var nowDateTime = "";
	var nowHourMinute = "";
	
	var year = dt.getFullYear();
	var month = dt.getMonth();
	var date = dt.getDate();
	
	var hour = dt.getHours();
	var minutes = dt.getMinutes();
	
	month = month + 1;
	
	if(month > 12){
		month = 1;
	}
	if(month < 10){
		month = '0' + month;
	}
	if(date < 10){
		date = '0' + date;
	}
	if(hour < 10){
		hour = '0' + hour;
	}
	if(minutes < 10){
		minutes = '0' + minutes;
	}
