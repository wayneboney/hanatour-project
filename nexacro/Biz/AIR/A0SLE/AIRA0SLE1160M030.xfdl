                          <Combo id="cbo_emrgMpCntryCd" taborder="1" left="135" top="2" width="131" height="23" innerdataset="ds_emrgTelCntryCd" codecolumn="comDtlCd" datacolumn="comDtlCdNm" autoselect="true" autoskip="true" type="filter" text="" displaynulltext="SELECT"/>
