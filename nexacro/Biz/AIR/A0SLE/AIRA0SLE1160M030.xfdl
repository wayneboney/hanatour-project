	this.gfn_openPopup(objForm, sPopupId, sUrl, objArgument, sPopupCallback, objOption);
};


/***************************************************************************
 * 함  수  명   : fn_resCreation
 * 기      능   : 예약생성하기
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_resCreation = function()
{
	var sMsg = "예약하기 전 아래 내용을 반드시 확인하셔야 합니다.\n"+
							"●가는편 편도+오는편 편도 운임을 결합한 왕복 운임입니다.\n가는편/오는편 각각 예약번호가 생성되며, 반드시 예약번호별로 각각 결제 및 발권요청을 진행해 주셔야 합니다.\n"+
							"●예약 완료 후 영문 성명, 성별 변경이 불가능하오니 실제 탑승하실 분의 여권상 동일한 영문 성명과 성별을 입력하여 주십시오.\n"+
							"●예약 후 미발권 시 반드시 예약취소 처리를 해야 합니다. 미취소 시 항공사 SEG FEE가 대리점으로 부과됩니다.\n"+
							"●예약관리 권한은 예약대리점에 있으니, 스케줄 변경으로 인한 문제 발생시 하나투어에서 책임지지 않습니다.\n"+
							"위 내용을 확인하셨습니까?";
	/*this.gfn_confirm(this, "예약하기 전 아래 내용을 반드시 확인하셔야 합니다.\n"+
							"●예약 완료 후 영문 성명, 성별 변경이 불가능하오니 실제 탑승하실 분의 여권상 동일한 영문 성명과 성별을 입력하여 주십시오.\n"+
							"●예약 후 미발권 시 반드시 예약취소 처리를 해야 합니다. 미취소 시 항공사 SEG FEE가 대리점으로 부과됩니다.\n"+
							"●예약관리 권한은 예약대리점에 있으니, 스케줄 변경으로 인한 문제 발생시 하나투어에서 책임지지 않습니다.\n"+
							"위 내용을 확인하셨습니까?",[], "", function (sId, sVal)*/
	if(this.fareTypeNdc ==='N'){//NDC확인
		this.fn_ndcpatpostMsg(sMsg);//여권 정보 확인 후 NDC메세지 처리 후 SAVE
	}else if(this.fareTypeNdc ==='R'){//NUUA확인
		this.fn_nuuaSaveMsg(sMsg);
	}else{
		if(this.getOwnerFrame().form.div_work.form.fv_airFarCombYn=="Y"){
			this.gfn_confirm(this, sMsg, ["", ""], "C", function (sId, sVal)
			{
				if(sVal) {
					this.fn_agtTelYnChk();
				}
			});
		}else{
			this.gfn_confirm(this, "IUIAIR100752", ["", ""], "C", function (sId, sVal)
			{
				if(sVal) {
					//대리점 전화번호 체크 유무체크
					this.fn_agtTelYnChk();
				}
			});
		}
	}
};
/***************************************************************************
 * 함  수  명   : fn_agtTelYnChk
 * 기      능   : 대리점 전화번호 체크 유무체크
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_agtTelYnChk = function()
{
	// 공통Transaction 호출
	var sSvcId  		= "getAgtTelSrch";
	var sSvcUrl  		= "svcUrl::";
	var sInDs   		= "body=ds_dumy:A";
	var sOutDs  		= "ds_agtTelSrchOut=body_agtTelSrchQcOutVo";

	var sArg 			= "";
	var sCallbackFunc 	= "fn_callBack";

	var objHeader       = this.bfn_rsvTranInit();
	
	objHeader.svcTrncId = "/air/ols/reserve/airMgr/air/agttelsrch/getAgtTelSrch/v1.00";// 헤더_서비스 처리_서비스거래ID
	
	this.gfn_callTran(this, sSvcId, sSvcUrl, sInDs, sOutDs, sArg, sCallbackFunc, objHeader);
};

/***************************************************************************
 * 함  수  명   : fn_resCeationProc
 * 기      능   : 예약생성하기 진행
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_resCeationProc = function()
{
	this.ds_resBasicInfoIn.clearData();
	this.ds_resBasicInfoIn.addRow();
	
	this.ds_resBasicInfoIn.setColumn(0, "reqrDvCd", "C");//요청자구분코드(대리점:M, 판매점:L, 공급사:S, 고객:C)
	this.ds_resBasicInfoIn.setColumn(0, "resPathCd", "PPP");//예약경로코드(닷컴:D02, 매니저:PPP, 공템(회원사):T06, 범용닷컴:D07)
	if(this.divPaxInfo.form.div00.form.rdoSite.value != "STD1"){
		this.ds_resBasicInfoIn.setColumn(0, "resPathCd", "PPP");//예약경로코드(닷컴:D02, 매니저:PPP, 공템(회원사):T06, 범용닷컴:D07)
	}
	else{
		this.ds_resBasicInfoIn.setColumn(0, "resPathCd", "D01");//예약경로코드(콜센터 예약:D01)
	}
	this.ds_resBasicInfoIn.setColumn(0, "fareId", this.parent.parent.parent.parent.ds_resCret.getColumn(0, "fareId"));//운임ID
	this.ds_resBasicInfoIn.setColumn(0, "resPayType", "A");//예약결재타입(P:즉시결재 , A:추후결재)
	
	//예약인원
	var adtCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "adtCnt");
	var chdCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "chdCnt");
	var infCnt = this.parent.parent.parent.parent.ds_resCret.getColumn(0, "infCnt");
	var resNop = parseInt(adtCnt) + parseInt(chdCnt) + parseInt(infCnt);
	this.ds_resBasicInfoIn.setColumn(0, "resNop", resNop);//예약인원
	this.ds_resBasicInfoIn.setColumn(0, "frdmTrvlResYn", "N");//자유여행만들기예약여부(Y,N)
	if(this.divPaxInfo.form.div00.form.rdoResDv.value == "ST06"){//법인예약
		this.ds_resBasicInfoIn.setColumn(0, "btrpPupsCd", this.divPaxInfo.form.div02.form.rdoBizPurpose.value);//(법인)출장목적코드(4자리)
		var nIdx = this.divPaxInfo.form.div00.form.cboSiteCats.index;
		var memcSiteCd = this.divPaxInfo.form.div00.form.cboSiteCats.value;
		var ptnCd = this.fv_objApp.gds_userInfo.getColumn(0, "unfyPtnCd");
		var crpnCustCmpaCd = "";//법인코드
		if(this.ds_schCrpnInfo.getRowCount() > 0){//법인회원사을 검색한 경우
			crpnCustCmpaCd = this.ds_schCrpnInfo.getColumn(nIdx, "ptnCd");//법인코드
		}else{//그외
			crpnCustCmpaCd = this.ds_selComListCats.getColumn(nIdx, "ptnCd");//법인코드
		}
		
		this.ds_resBasicInfoIn.setColumn(0, "memcSiteCd", (memcSiteCd == "99" || memcSiteCd == "00") ? "" : memcSiteCd);//회원사사이트코드
		this.ds_resBasicInfoIn.setColumn(0, "ptnCd", ptnCd);//거래처코드
		this.ds_resBasicInfoIn.setColumn(0, "crpnCustCmpaCd", this.gfn_isNull(crpnCustCmpaCd) ? "" : crpnCustCmpaCd);//법인코드
		
		this.ds_resBasicInfoIn.setColumn(0, "resCustDvCd", "C");//예약고객구분코드(null,I:개인고객/C:법인코드)
		
	}else{//일반예약
		var nIdx = this.divPaxInfo.form.div00.form.cboSiteMgr.index;
		var memcSiteCd = this.divPaxInfo.form.div00.form.cboSiteMgr.value;
		var siteVal = this.divPaxInfo.form.div00.form.rdoSite.value;
		var ptnCd = "";
		if(siteVal == "MGR"){//하나허브
		
			ptnCd = this.ds_selComListMgr.getColumn(1, "ptnCd");//거래처코드 콤보박스(미노출)idx 1로 set
		
			
			if(ptnCd == null) {
				ptnCd = this.fv_objApp.gds_userInfo.getColumn(0, "unfyPtnCd");
			}
			memcSiteCd = ''; //일반예약-하나허브 예약시 memcSiteCd null로 set
		}else if(siteVal == "ALL"){//홈페이지
			ptnCd = this.ds_selComListHomePage.getColumn(nIdx, "ptnCd");//거래처코드
		}else if(siteVal == "STD3"){//닷컴
			ptnCd = this.ds_selComListDotCom.getColumn(nIdx, "ptnCd");//거래처코드
		}else if(siteVal == "STD1"){//콜센터
			//ptnCd = this.ds_selComListCallCenter.getColumn(nIdx, "ptnCd");//거래처코드 A0000
			ptnCd = this.ds_selComListMgr.getColumn(nIdx, "ptnCd");//거래처코드 로그인정보
		}
		var crpnCustCmpaCd = "";//법인코드
		
		this.ds_resBasicInfoIn.setColumn(0, "memcSiteCd", memcSiteCd);//회원사사이트코드
		this.ds_resBasicInfoIn.setColumn(0, "ptnCd", ptnCd);//거래처코드
		this.ds_resBasicInfoIn.setColumn(0, "crpnCustCmpaCd", crpnCustCmpaCd);//법인코드
		
		this.ds_resBasicInfoIn.setColumn(0, "resCustDvCd", "I");//예약고객구분코드(null,I:개인고객/C:법인코드)
	}
	
	//카드프로모션 정보
	this.ds_promCardInfoIn.clearData();
	if(this.parent.parent.parent.parent.ds_cardList.getRowCount() > 0){
		var idxNum = this.parent.parent.parent.parent.divLastItnr.form.divCard.form.rdoCard.index;
		if(!this.gfn_isNull(this.parent.parent.parent.parent.ds_cardList.getColumn(idxNum, "cardPromId"))){
			this.ds_promCardInfoIn.addRow();
			this.ds_promCardInfoIn.setColumn(0, "cardPromId", this.parent.parent.parent.parent.ds_cardList.getColumn(idxNum, "cardPromId"));//카드프로모션ID
			this.ds_promCardInfoIn.setColumn(0, "eventId", this.parent.parent.parent.parent.ds_cardList.getColumn(idxNum, "eventCd"));//이벤트코드
		}
	}
	
	//대리점 정보
	this.ds_ptnInfoIn.clearData();
	this.ds_ptnInfoIn.addRow();
	
	this.ds_ptnInfoIn.setColumn(0, "prngPtnNm", this.fv_objApp.gds_userInfo.getColumn(0, "unfyPtnNm"));//출력거래처명(API 사용안함)
	this.ds_ptnInfoIn.setColumn(0, "stafIdA", this.fv_objApp.gds_userInfo.getColumn(0, "empn"));//도우미예약담당직원아이디A
	this.ds_ptnInfoIn.setColumn(0, "stafIdB", this.fv_objApp.gds_userInfo.getColumn(0, "empn"));//도우미예약담당직원아이디B
	this.ds_ptnInfoIn.setColumn(0, "stafKoNm", this.fv_objApp.gds_userInfo.getColumn(0, "usrKoNm"));//대리점직원한글명(API 사용안함)
	this.ds_ptnInfoIn.setColumn(0, "txinDvCd", this.divPaxInfo.form.div02.form.rdoTrType.value);//세금계산서발행구분
	
	//고객정보동의
	this.ds_pdatInfAgrListIn.clearData();
	
	for(var i = 0; i < this.ds_farRulesSvcRulLstOut.getRowCount(); i++){
		this.ds_pdatInfAgrListIn.addRow();
		this.ds_pdatInfAgrListIn.setColumn(i, "svcRulNum", this.ds_farRulesSvcRulLstOut.getColumn(i, "svcRulNum"));//서비스규정번호
		this.ds_pdatInfAgrListIn.setColumn(i, "agrtStatCd", this.ds_farRulesSvcRulLstOut.getColumn(i, "esntYn"));//필수여부
	}
	
	//예약자 정보
	this.ds_bkrInfoIn.clearData();
	this.ds_bkrInfoIn.addRow();
	
	this.ds_bkrInfoIn.setColumn(0, "custNum", "");//고객번호
	this.ds_bkrInfoIn.setColumn(0, "memYn", "");//회원여부
	this.ds_bkrInfoIn.setColumn(0, "bkrKoNm", this.ds_BdngInfo.getColumn(0, "paxLclName"));//예약자명
	this.ds_bkrInfoIn.setColumn(0, "bkrEnln", this.ds_BdngInfo.getColumn(0, "paxLastName"));//예약자 영문성
	this.ds_bkrInfoIn.setColumn(0, "bkrEnNm", this.ds_BdngInfo.getColumn(0, "paxFirstName"));//예약자 영문이름
	this.ds_bkrInfoIn.setColumn(0, "bkrEnMidNm", "");//예약자 영문중간이름
	this.ds_bkrInfoIn.setColumn(0, "bkrEml", this.ds_BdngInfo.getColumn(0, "email"));//예약자 EMAIL
	this.ds_bkrInfoIn.setColumn(0, "bkrBthd", this.ds_BdngInfo.getColumn(0, "birthDay"));//예약자생년월일
	this.ds_bkrInfoIn.setColumn(0, "afcnMemId", "");//제휴사이트 회원ID
	this.ds_bkrInfoIn.setColumn(0, "nvrFareKndCd", "");//네이버요금종류코드
	this.ds_bkrInfoIn.setColumn(0, "bkrCntryCd", "KR");//예약자국가코드
	this.ds_bkrInfoIn.setColumn(0, "emrgMpn", this.divPaxInfo.form.div_btn.form.div00.form.edt_emrgMpn.value);
	this.ds_bkrInfoIn.setColumn(0, "emrgMpCntryCd", this.divPaxInfo.form.div_btn.form.div00.form.cbo_emrgMpCntryCd.value);
	
	//예약자 정보 연락처 정보
	this.ds_ctpListIn.clearData();
	this.ds_ctpListIn.addRow();
	
	this.ds_ctpListIn.setColumn(0, "ctpDvCd", "1");//연락처 구분코드
	this.ds_ctpListIn.setColumn(0, "cntryNum", "82");//국가번호
	this.ds_ctpListIn.setColumn(0, "tel", this.ds_BdngInfo.getColumn(0, "mobileNo"));//전화번호
	this.ds_ctpListIn.setColumn(0, "rprsYn", "Y");//대표연락처여부
	
	//탑승객 리스트
	this.ds_psngrListIn.clearData();
	this.ds_ctpInfoIn.clearData();
	for(var i = 0; i < this.ds_BdngInfo.getRowCount(); i++){
		this.ds_psngrListIn.addRow();
		this.ds_psngrListIn.setColumn(i, "psngrSeq", i+1);//탑승객 순번
		this.ds_psngrListIn.setColumn(i, "bkrYn", i+1 == 1 ? "Y" : "N");//탑승객과 예약자가 동일할 경우 Y, 아니면 N
		this.ds_psngrListIn.setColumn(i, "custNum", "");//고객번호
		this.ds_psngrListIn.setColumn(i, "memYn", "");//회원여부
		this.ds_psngrListIn.setColumn(i, "tustKoNm", this.ds_BdngInfo.getColumn(i, "paxLclName"));//여행자 현지어명
		this.ds_psngrListIn.setColumn(i, "tustEnln", this.ds_BdngInfo.getColumn(i, "paxLastName"));//여행자 영문성
		this.ds_psngrListIn.setColumn(i, "tustEnNm", this.ds_BdngInfo.getColumn(i, "paxFirstName"));//여행자 영문이름
		this.ds_psngrListIn.setColumn(i, "tustEnMidNm", "");//여행자 영문중간이름
		this.ds_psngrListIn.setColumn(i, "tustCntryCd", this.ds_BdngInfo.getColumn(i, "tustCntryCd"));//여행자 국적코드
		this.ds_psngrListIn.setColumn(i, "psngrDvCd", this.ds_BdngInfo.getColumn(i, "pasnType"));//탑승객 구분
		this.ds_psngrListIn.setColumn(i, "tustGndrDvCd", this.ds_BdngInfo.getColumn(i, "gender"));//여행자 성별
		this.ds_psngrListIn.setColumn(i, "tustAgeDvCd", this.ds_BdngInfo.getColumn(i, "ageType"));//여행자 나이구분(A/C/I)
		this.ds_psngrListIn.setColumn(i, "tustBthd", this.ds_BdngInfo.getColumn(i, "birthDay"));//여행자생년월일
		this.ds_psngrListIn.setColumn(i, "tustPpn", this.ds_BdngInfo.getColumn(i, "tustPpn"));//탑승객 여권번호
		this.ds_psngrListIn.setColumn(i, "tustPsptExpyCd", this.ds_BdngInfo.getColumn(i, "tustPsptExpyDt"));//탑승객 여권만료일
		this.ds_psngrListIn.setColumn(i, "tustCntryCd", this.ds_BdngInfo.getColumn(i, "tustCntryCd"));//탑승객 국가 코드 
		this.ds_psngrListIn.setColumn(i, "tustPsptPublCntryCd", this.ds_BdngInfo.getColumn(i, "tustPsptPublCntryCd"));//탑승객 발행권 국가코드

		//탑승객 리스트 연락처 정보
		if(!this.gfn_isNull(this.ds_BdngInfo.getColumn(i, "mobileNo"))){
			this.ds_ctpInfoIn.addRow();
			this.ds_ctpInfoIn.setColumn(i, "ctpDvCd", this.gfn_isNull(this.ds_BdngInfo.getColumn(i, "mobileNo")) ? "" : "1");//연락처구분코드
			this.ds_ctpInfoIn.setColumn(i, "cntryNum", this.gfn_isNull(this.ds_BdngInfo.getColumn(i, "mobileNo")) ? "" : "82");//국가번호
			this.ds_ctpInfoIn.setColumn(i, "tel", this.ds_BdngInfo.getColumn(i, "mobileNo"));//전화번호
		}
		
		this.ds_psngrListIn.setColumn(i, "tustEmlAdrs", this.ds_BdngInfo.getColumn(i, "email"));//탑승객 EMAIL
		this.ds_psngrListIn.setColumn(i, "hlsMemNum", "");//마일리지 회원번호(HLS회원번호)
	}
	this.fn_roam_log_update_after();
	this.fn_romanizaion_result_logging();
	
	// 공통Transaction 호출
 	var sSvcId  		= "resCreation";
 	var sSvcUrl  		= "svcUrl::";
 	var sInDs   		= "body=ds_dumy:A body_resCreationBasicInVo=ds_resBasicInfoIn body_resPromCardInfoInVo=ds_promCardInfoIn body_resPtnInfoInVo=ds_ptnInfoIn body_resPdatInfAgrListInVo=ds_pdatInfAgrListIn body_resBkrInfoInVo=ds_bkrInfoIn body_resCtpListInVo=ds_ctpListIn body_resPsngrListInVo=ds_psngrListIn body_resCtpInfoInVo=ds_ctpInfoIn body_rsvAirPsngrStayInfoQcVoList=ds_stayList";
 	var sOutDs  		= "ds_headInfoOut=body_testHeadOutVo ds_returnBizComOut=body_returnBizComVo ds_resCreatInfoOut=body_resCreatBasicInfoFinalVo ds_psngrListOut=body_resPsngrListFinalVo ds_airSchListOut=body_resAirSchListFinalVo ds_airHtrrgList=body_resAirHtrrgListFinalVo ds_ptnInfoOut=body_resPtnInfoFinalVo";
 
 	var sArg 			= "";
 	var sCallbackFunc 	= "fn_callBack";
 
 	var objHeader       = this.bfn_rsvTranInit();
 	
 	objHeader.svcTrncId = "/air/ols/reserve/airmgr/res/rescreation/setResCreation/v1.00";// 헤더_서비스 처리_서비스거래ID
 	
	
	trace(this.ds_resBasicInfoIn.saveXML());
 	this.gfn_callTran(this, sSvcId, sSvcUrl, sInDs, sOutDs, sArg, sCallbackFunc, objHeader);
};

