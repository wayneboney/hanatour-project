/***************************************************************************
 * 함  수  명   : fn_txinKndSetting
 * 기      능   : 세금계산서 라디오 구성
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_txinKndSetting = function()
{
	this.ds_txinType.clearData();
	//거래처기본 데이터가 있을시 T/R 모두 거래 가능
	//없는경우 T거래만 가능
	if(this.ds_txinKndOut.getRowCount() > 0){
		this.ds_txinType.addRow();
		this.ds_txinType.setColumn(0, "codeVal", "T");
		this.ds_txinType.setColumn(0, "codeNm", "발행함(T)");
		this.ds_txinType.addRow();
		this.ds_txinType.setColumn(1, "codeVal", "R");
		this.ds_txinType.setColumn(1, "codeNm", "수수료 없음(R)");
	}else{
		this.ds_txinType.addRow();
		this.ds_txinType.setColumn(0, "codeVal", "T");
		this.ds_txinType.setColumn(0, "codeNm", "발행함(T)");
	}
	this.divPaxInfo.form.div02.form.rdoTrType.set_index(0);
};
