		this.divPaxInfo.form.div01.form.grdBdngInfo.dropdownCombo();
	}
	
};

/***************************************************************************
 * 함  수  명   : divPaxInfo_div01_grdBdngInfo_onkeyup
 * 기      능   : 승객정보 영문성, 영문이름 입력 keyup 이벤트('TEST' 입력시 알림창)
 **************************************************************************/
this.divPaxInfo_div01_grdBdngInfo_onkeyup = function(obj:nexacro.Grid,e:nexacro.KeyEventInfo)
{
	var nRow = obj.getSelectedRows();
	var nCell = obj.getCellPos();
	var validDataSet = this.ds_BdngInfo;
	var validGridElement = this.divPaxInfo.form.div01.form.grdBdngInfo;
	var validTargetValue = obj.getEditValue();
	var errorMsg = ""
	var bindName = "";
	
	if (validTargetValue == "") {
		// 공백이면 validation하지 않음
		return false;
	}
	if (obj.getCellPos() == 2 && !this.fn_hangl(validTargetValue)) {
		bindName = "paxLclName";
		errorMsg = "한글명을 입력해주세요.";
	} else if (obj.getCellPos() == 3 || obj.getCellPos(validTargetValue) == 4) {
		bindName = obj.getCellPos() == 3 ? "paxLastName": "paxFirstName";
		var pattern = /\s/g;
		if(!this.fn_alpha(validTargetValue)) {
			errorMsg = "영문명을 입력해주세요.";
		} else if(validTargetValue.match(pattern)) {
			errorMsg = "영문명에 공백없이 입력해주세요.";
		}
	}
	
	if(errorMsg != "") {
		this.gfn_alert(this, errorMsg);
		validDataSet.setColumn(nRow, bindName, "");
		validGridElement.setFocus();
		validGridElement.setCellPos(validGridElement.getBindCellIndex("body", bindName), nRow);
	}
	
 	//휴대폰 입력 체크
 	if(e.columnid == "mobileNo"){
 		if( !this.fn_checkPhone(this.ds_BdngInfo.getColumn(e.row, "mobileNo"), e.row)) {
 			return false;   
 		}
 	}
	//E-Mail 입력 체크
	if(e.columnid == "email"){
		if( !this.fn_checkEmail(this.ds_BdngInfo.getColumn(e.row, "email"), e.row)) {
			return false;   
		}
	}
	
	//법정생년월일 입력 유효성 검증
	if(e.columnid == "birthDay"){
		if( !this.fn_checkBirthDate(this.ds_BdngInfo.getColumn(e.row, "birthDay"), e.row)) {
			return false;   
		}
	}
};

/***************************************************************************
 * 함  수  명   : divPaxInfo_div00_rdoSite_onitemchanged
 * 기      능   : 웹사이트지정 라디오 클릭 이벤트
 **************************************************************************/
this.divPaxInfo_div00_rdoSite_onitemchanged = function(obj:nexacro.Radio,e:nexacro.ItemChangeEventInfo)
{
	var rdoSiteVal = this.divPaxInfo.form.div00.form.rdoSite.value;//웹사이트지정
	if(rdoSiteVal == "MGR"){
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(false);
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_innerdataset(this.ds_selComListMgr);
		if(this.fv_cboMgrIdx != 0){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboMgrIdx);
		}else{
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
		}
	}else if(rdoSiteVal == "ALL"){
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_innerdataset(this.ds_selComListHomePage);
		if(this.fv_cboHomePageIdx != 0){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboHomePageIdx);
		}else{
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
		}
	}else if(rdoSiteVal == "STD3"){
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_innerdataset(this.ds_selComListDotCom);
		if(this.fv_cboDotComIdx != 0){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboDotComIdx);
		}else{
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(0);
		}
	}else if(rdoSiteVal == "STD1"){
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_visible(true);
		this.divPaxInfo.form.div00.form.cboSiteMgr.set_innerdataset(this.ds_selComListCallCenter);
		if(this.fv_cboCallCenterIdx != 0){
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(this.fv_cboCallCenterIdx);
		}else{
			this.divPaxInfo.form.div00.form.cboSiteMgr.set_index(1);//콜센터 선택 시 하나투어 닷컴 콜센터(C00002S001)콤보 세팅
		}
	}
};

/***************************************************************************
 * 함  수  명   : divPaxInfo_div01_grdBdngInfo_oncellposchanged
 * 기      능   : 법정생년월일, 휴대폰, E-Mail 입력 키인시 기본 텍스트 문구 삭제 이벤트
 **************************************************************************/
this.divPaxInfo_div01_grdBdngInfo_oncellposchanged = function(obj:nexacro.Grid,e:nexacro.GridSelectEventInfo)
{
	var bodyNm = "";
	var val = "";

	if(e.col == 6 || e.col == 7 || e.col == 8){
		if(this.fareTypeNdc == 'N' || this.fareTypeNdc == 'R'){
			this.bdngIndex = e.row;
			var rowIndex = e.row;
			var cellIndex = e.cell
			
			bodyNm = obj.getCellProperty("Body", cellIndex, "text").replace("bind:", "");
			val = this.ds_BdngInfo.getColumn(rowIndex, bodyNm);
			
		}else{
			if(e.col == 6){
				bodyNm = "birthDay";
				val = this.ds_BdngInfo.getColumn(obj.currentrow, "birthDay");
			}else if(e.col == 7){
				bodyNm = "mobileNo";
				val = this.ds_BdngInfo.getColumn(obj.currentrow, "mobileNo");
			}else if(e.col == 8){
				bodyNm = "email";
				val = this.ds_BdngInfo.getColumn(obj.currentrow, "email");
			}
		}
		//탭 및 백탭의 경우 인자값이 있으면 커서를 제일 마지막에 위치
		var valLength = this.ds_BdngInfo.getColumn(obj.currentrow, bodyNm);
		this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
		if(!this.gfn_isNull(valLength)){
			this.divPaxInfo.form.div01.form.grdBdngInfo.setEditSelect(valLength.length, -1);
		}
	}else if(e.col == 2 || e.col == 3 || e.col == 4){
		//탭 및 백탭의 경우 인자값이 있으면 커서를 제일 마지막에 위치(한글성명, 영문성, 영문이름)
		if(e.col == 2){
			bodyNm = "paxLclName";
			
		}else if(e.col == 3){
			bodyNm = "paxLastName";
		}else if(e.col == 4){
			bodyNm = "paxFirstName";
		}
		var valLength = this.ds_BdngInfo.getColumn(obj.currentrow, bodyNm);
		this.divPaxInfo.form.div01.form.grdBdngInfo.showEditor(true);
		if(!this.gfn_isNull(valLength)){
			this.divPaxInfo.form.div01.form.grdBdngInfo.setEditSelect(valLength.length, -1);
		}
	}
	
	var oldCell = this.fv_ndcOldCell;
	this.fn_romanizaion_check_process(e.oldrow, bodyNm, oldCell);
	if(this.fareTypeNdc==="N" || this.fareTypeNdc==="R" && (bodyNm ==="paxLclName" || bodyNm ==="birthDay"|| bodyNm ==="tustPpn")){
		this.fv_ndcOldCell = bodyNm;
	}else{
		this.fv_ndcOldCell = "";
	}
};


 /***************************************************************************
 * 함  수  명   : fn_hangl
 * 기      능   : dataset 의  필수값 누락 정보
 * 인      자   : str - String
 * 리  턴  값   : boolean : 한글여부 - 아니면 false
 ***************************************************************************/

  this.fn_hangl = function(objArgument){

        	var vChk = /[ㄱ-ㅎ|ㅏ-ㅣ|가-힣]/;
        	if(!vChk.test(objArgument)) {
			
        		return false;
        	}
            return true;
        }


 /***************************************************************************
 * 함  수  명   : fn_alpha
 * 기      능   : dataset 의  필수값 누락 정보
 * 인      자   : str - String
 * 리  턴  값   : boolean : 한글여부 - 아니면 false
 ***************************************************************************/
this.fn_alpha = function(str)
{
	var alpha = true;
	var check = /[a-z|A-Z]/;
	if(!check.test(str)) {
		alpha = false;
	}
	return alpha;  
}


/***************************************************************************
 * 함  수  명   : fn_searchTelCntryCode
 * 기      능   : 국가코드 공통
 * 인      자   : 없음
 * 리  턴  값   : 없음
 ***************************************************************************/
this.fn_searchTelCntryCode = function()
{  
	var sSvcId  		= "TEL_EMRG_CNTRY_CD"; 
	var sSvcUrl  		= "svcUrl::";
 
	var sInDs   		= "body=ds_dummy body_saleCodeVo==ds_search:A"; //:U 는 갱신된 정보만을 보냄 :A 는 모든 정보 :N 은 현재 삭제한 데이터를 제외한 정보를 Normal 상태로 보냅니다. 지정하지 않은 DataSet 은 Normal 로 동작합니다.
	var sOutDs  		= "ds_emrgTelCntryCd=body_saleListCdVo";
	var sArg 			= "";
	var sCallbackFunc 	= "fn_callBack";
    
	// 초기값은 fn_tranInit 설정
	var objHeader = this.bfn_rsvTranInit(); 
	objHeader.svcTrncId = "/air/ols/sale/saleutl/saleutil/getEmrgCtryTelList/v1.00";		// 헤더_서비스 처리_서비스거래ID 
	this.gfn_callTran(this, sSvcId, sSvcUrl, sInDs, sOutDs, sArg, sCallbackFunc, objHeader);	
};


//그리드 클릭시(국적선택 - 국가검색 팝업호출)
this.divPaxInfo_div01_grdBdngInfo_onexpandup = function(obj:nexacro.Grid,e:nexacro.GridMouseEventInfo)
{
	var  bind  = obj.getCellProperty("body",  e.cell, "text").split("bind:")[1];
	if( bind == "tustCntryCd" ) {
		var sCntryCd = this.ds_BdngInfo.getColumn( e.row, 'tustCntryCd' );
		this.bfn_cntryPopup(this, {search:sCntryCd, sFunction:'', sFunction2:'fn_cntryPopup02'});
	}
	
	if( bind == "tustPsptPublCntryCd" ) {
		var sCntryCd = this.ds_BdngInfo.getColumn( e.row, 'tustPsptPublCntryCd' );
		this.bfn_cntryPopup(this, {search:sCntryCd, sFunction:'', sFunction2:'fn_cntryPopup03'});
	}
};

//국적 입력시 유효성검사
this.ds_BdngInfo_cancolumnchange = function(obj:nexacro.NormalDataset,e:nexacro.DSColChangeEventInfo)
{
	if( e.columnid == "tustCntryCd" ) {
		var grd = this.divPaxInfo.form.div01.form.grdBdngInfo;
		var param = {code:e.newvalue,type:"contry" };
	    var ds = this.bfn_rsvValidCode(param);
		
		if ( ds.rowcount == 0 ) { 
			var funFunc = function () { 
				grd.setCellPos( grd.getBindCellIndex("Body", e.columnid  ));
				grd.setFocus();
				
				var sCntryCd = this.ds_BdngInfo.getColumn( e.row , 'tustCntryCd' );
				this.bfn_cntryPopup(this, {search:sCntryCd, sFunction:'', sFunction2:'fn_cntryPopup02'});
				
				return;			
			} 
			
			this.gfn_alert ( this, "IUIAIR000046", [], "I", funFunc ) ; //해당되는 코드가 존재하지 않습니다. 
			return false;
	    }
	}
	
	var vRiRtType = this.getOwnerFrame().form.div_work.form.ds_lastChcItnrFarAmt.getColumn(0, "apiSupCode");
	if(vRiRtType != "V") {
		if( e.columnid == "paxLastName" || e.columnid == "paxFirstName") {
			e.newvalue = nexacro.replaceAll(e.newvalue, "+", "");
			e.newvalue = nexacro.replaceAll(e.newvalue, "-", "");
		}
	} else {
		if( e.columnid == "paxLastName" || e.columnid == "paxFirstName") {
			e.newvalue = nexacro.replaceAll(e.newvalue, "+", "");
			e.newvalue = nexacro.replaceAll(e.newvalue, "-", "");
		}
	}
	
};

