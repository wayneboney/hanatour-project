							}
						}
						
					} else if(this.ds_BdngInfo.getColumn(i, "ageType") == "I") {
						if(this.ds_infAgeChkAlCode.findRow("mktAlCode", mktAlCode01, mktAlCode02, mktAlCode03, mktAlCode04, mktAlCode05, mktAlCode06) > 0){
