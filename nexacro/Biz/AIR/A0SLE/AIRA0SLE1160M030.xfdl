							//출국일 기준 예약불가
							if( !(parseInt(depAge) >= 2 && parseInt(depAge) < 12)) {
							
								//this.gfn_alert(this, "아동의 경우 출발일 기준 만12세 미만이어야 합니다.", "", "I", function()
								this.gfn_alert(this, "IUIAIR100748", ["", ""], "I", function()
