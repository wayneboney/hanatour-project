						if(parseInt(depAge) >= 2){
							//this.gfn_alert(this, "유아의 경우 출발일/귀국일 기준 만2세 미만이어야 합니다.", "", "I", function()
							this.gfn_alert(this, "IUIAIR100749", ["", ""], "I", function()
								  {
