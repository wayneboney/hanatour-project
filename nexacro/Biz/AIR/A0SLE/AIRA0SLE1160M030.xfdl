	}else{
		//탑승객 영문이름 중복 체크
		for(var i = 0; i < totCnt; i++) {
			var paxName = this.ds_BdngInfo.getColumn(i, "paxLastName") + this.ds_BdngInfo.getColumn(i, "paxFirstName");
			for(var j = i+1; j < totCnt; j++) {
				var comparisonName = this.ds_BdngInfo.getColumn(j, "paxLastName") + this.ds_BdngInfo.getColumn(j, "paxFirstName");
				if(paxName == comparisonName){
					//this.gfn_alert(this, "탑승객의 영문 이름을 확인해주세요. 하나의 예약에 동일한 이름으로 두 명 이상 예약되지 않습니다.");
					this.gfn_alert(this, "IUIAIR100750", ["", ""], "I", "", "IUIAIR100750");
					return false;
				}
			}
		}
		
		if(adtAge) {
			//this.gfn_alert(this, "성인(만 18세 이상) 동반 없이 여행하는 만 12~17세 이하 청소년의 경우 운송항공사의 운영 정책에 따라 탑승이 제한 또는 거절 될 수 있습니다. 항공권 구매 전 해당 항공사로 필히 확인 부탁 드립니다.", "", "I", function()
